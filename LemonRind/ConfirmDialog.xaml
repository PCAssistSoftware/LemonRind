<Window x:Class="ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        Icon="Assets/AppIcon.ico"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/DialogButtonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageTextBlock" Grid.Row="0" TextWrapping="Wrap" FontSize="14" LineHeight="20" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="CancelButtonElement" Padding="14,7" Margin="0,0,8,0"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    Click="OnCancelClick" IsCancel="True" />
            <Button x:Name="ConfirmButtonElement" Padding="14,7"
                    Style="{StaticResource DialogPrimaryButtonStyle}"
                    Click="OnConfirmClick" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
