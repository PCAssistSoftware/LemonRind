<Window x:Class="ImageSizeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image size" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        Icon="Assets/AppIcon.ico"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <!-- Shared button styles - extracted to Styles/DialogButtonStyles.xaml
         since MoveToFolderDialog/TagManagerDialog need the same two styles
         this and ConfirmDialog also use. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/DialogButtonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="The assistant wants to generate an image:" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" x:Name="PromptPreviewText" TextWrapping="Wrap" FontSize="13" Foreground="Gray" Margin="0,0,0,16" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Width" Foreground="Gray" FontSize="12" Margin="0,0,0,2" />
                <TextBox x:Name="WidthBox" Padding="6" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Height" Foreground="Gray" FontSize="12" Margin="0,0,0,2" />
                <TextBox x:Name="HeightBox" Padding="6" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="CancelButtonElement" Content="Cancel" Padding="14,7" Margin="0,0,8,0"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    Click="OnCancelClick" IsCancel="True" />
            <Button x:Name="GenerateButtonElement" Content="Generate" Padding="14,7"
                    Style="{StaticResource DialogPrimaryButtonStyle}"
                    Click="OnGenerateClick" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
