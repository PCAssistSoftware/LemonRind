<Window x:Class="LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lemonade logs" Width="1300" Height="700" MinWidth="500" MinHeight="300"
        Icon="Assets/AppIcon.ico"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="StatusText" Text="Connecting..." Foreground="Gray" FontSize="12" Margin="0,0,0,8" />

        <!-- ListView+GridView, not a plain ItemsControl - this can hold
             thousands of entries (Lemonade retains up to
             5000), so real virtualization (ListView's default) matters
             here, unlike the small dropdown lists elsewhere in this app
             where virtualization was deliberately turned OFF for smoother
             scrolling - opposite tradeoff, different scale. Severity
             coloring via DataTrigger, not a converter - simpler, matches
             how IsUser-based bubble coloring already works elsewhere. -->
        <ListView Grid.Row="1" x:Name="LogListView" FontFamily="Consolas" FontSize="12"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Foreground" Value="#1C1C1E" />
                    <Setter Property="Padding" Value="4,1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Severity}" Value="Warn">
                            <Setter Property="Foreground" Value="#B8860B" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Severity}" Value="Error">
                            <Setter Property="Foreground" Value="#FF3B30" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Severity}" Value="Fatal">
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="Background" Value="#FF3B30" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Time" Width="150" DisplayMemberBinding="{Binding Timestamp}" />
                    <GridViewColumn Header="Severity" Width="70" DisplayMemberBinding="{Binding Severity}" />
                    <GridViewColumn Header="Tag" Width="120" DisplayMemberBinding="{Binding Tag}" />
                    <GridViewColumn Header="Line" Width="950" DisplayMemberBinding="{Binding Line}" />
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
