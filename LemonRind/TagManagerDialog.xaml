<Window x:Class="TagManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:LemonRind.Converters"
        Title="Manage tags" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        Icon="Assets/AppIcon.ico"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/DialogButtonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Tags" FontWeight="Bold" Margin="0,0,0,8" />

        <ItemsControl x:Name="TagsItemsControl" Grid.Row="1">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#E5E5EA" CornerRadius="10" Padding="8,3" Margin="0,0,6,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center" />
                            <Button Content="&#10005;" FontSize="9" Padding="4,0,0,0" Margin="6,0,0,0"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Click="OnRemoveTagClick" Tag="{Binding}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Grid.Row="1" Text="No tags yet." Foreground="Gray" FontStyle="Italic"
                    Visibility="{Binding Items.Count, ElementName=TagsItemsControl, Converter={StaticResource CountToVisibilityConverter}}" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBox x:Name="NewTagBox" Width="220" Padding="6" KeyDown="OnNewTagBoxKeyDown" />
            <Button Content="Add" Padding="12,6" Margin="8,0,0,0" Style="{StaticResource DialogSecondaryButtonStyle}" Click="OnAddTagClick" />
        </StackPanel>

        <Button Grid.Row="3" Content="Done" Padding="14,7" HorizontalAlignment="Right" Margin="0,20,0,0"
                Style="{StaticResource DialogPrimaryButtonStyle}" Click="OnDoneClick" IsDefault="True" IsCancel="True" />
    </Grid>
</Window>
