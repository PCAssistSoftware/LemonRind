<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />

    <!-- Foundation. Same versions as the VB.NET/WPF LemonRind app
         (..\LemonRind_WPF\LemonRind.vbproj), so both apps stay on identical
         Microsoft.Extensions.AI/OpenAI SDK behaviour - only the UI framework
         differs. -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="OpenAI" Version="2.14.0" />

    <!-- Web search/reader/file system tools. -->
    <PackageReference Include="HtmlAgilityPack" Version="1.13.0" />

    <!-- One-off file analysis (PDF/DOCX/XLSX/text attachment). -->
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />

    <!-- MCP client support. -->
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />

    <!-- Scheduler. -->
    <PackageReference Include="Cronos" Version="0.13.0" />

    <!-- Coder module. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" Version="5.9.0" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.12" />

    <!-- Markdown rendering for chat replies (the counterpart of Markdig.Wpf in
         the WPF app). .Tight
         (no AvaloniaEdit/syntax-highlighting dependency) rather than the
         full Markdown.Avalonia package - this app's own chat replies are
         prose/headers/bold/tables, not code-block-heavy, so the lighter
         variant matches this project's "start minimal" bias. MIT licensed.

         Pinned to the 12.0.0-a3 PRERELEASE, not the newer-looking stable
         11.0.3: 11.0.3's own dependency
         (ColorTextBlock.Avalonia 11.0.3) was compiled against Avalonia 11's
         GenericTextRunProperties constructor shape, which changed in
         Avalonia 12 - NuGet's loose "Avalonia >= 11.0.0" dependency range
         let it restore fine against this project's real Avalonia 12.1.3,
         but it crashed at runtime with a MissingMethodException the first
         time a bubble actually rendered (a real binary-compatibility gap
         restore-time version ranges can't catch). 12.0.0-a3's own
         dependencies are explicitly "Avalonia >= 12.0.0" / matching
         ColorTextBlock.Avalonia >= 12.0.0-a3, per NuGet's listed dependency
         versions. -->
    <PackageReference Include="Markdown.Avalonia.Tight" Version="12.0.0-a3" />

    <!-- Jina/Tavily/Firecrawl alternate search/read engines.
         Firecrawl's Crawl capability is a real async job (POST to start,
         poll to completion) - the official SDK already solves that
         polling/pagination correctly, same version the WPF app uses. -->
    <PackageReference Include="firecrawl-sdk" Version="1.14.0" />
  </ItemGroup>
</Project>
