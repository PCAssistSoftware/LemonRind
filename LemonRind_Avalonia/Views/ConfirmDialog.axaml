<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LemonRindAvalonia.Views.ConfirmDialog"
        Icon="/Assets/AppIcon.ico" Background="{DynamicResource PaneBg}" Title="Confirm" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" CanResize="False" ShowInTaskbar="False">

    <StackPanel Margin="16">
        <TextBlock Name="MessageText" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Name="CancelButton" Content="Cancel" Padding="12,6" Margin="0,0,8,0" Click="OnCancelClick" />
            <Button Name="ConfirmButton" Classes="primary" Content="Yes" Padding="12,6" Click="OnConfirmClick" />
        </StackPanel>
    </StackPanel>
</Window>
