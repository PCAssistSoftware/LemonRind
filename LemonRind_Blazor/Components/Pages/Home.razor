    {
        SessionRepository.SetAttachedKnowledgeBase(_currentSessionId, string.IsNullOrEmpty(_attachedKnowledgeBaseId) ? null : _attachedKnowledgeBaseId);
    }

    // One-off file attachment, not RAG ingestion (Knowledge.razor's
    // own AddFileSource handles that). Extraction happens immediately on
    // pick, not deferred to Send, so a corrupt/unsupported file fails fast
    // with the reason visible right away rather than after the user's
    // already typed and sent a question about it.
    private async Task OnAttachFile(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        var file = e.File;
        _attachError = null;

        // One attachment slot, routed by extension to either path - never
        // both at once, matching the desktop apps' own design. Checked
        // image-first since ImageAttachmentService's own supported list is
        // short and unambiguous; FileTextExtractor handles everything else.
        var isImage = ImageAttachmentService.IsSupported(file.Name);
        if (!isImage && !FileTextExtractor.IsSupported(file.Name))
        {
            var supported = ImageAttachmentService.SupportedExtensions.Concat(FileTextExtractor.SupportedExtensions);
            _attachError = $"'{file.Name}' isn't a supported file type ({string.Join(", ", supported)}).";
            StateHasChanged();
            return;
        }

        var uploadsDir = Path.Combine(AppContext.BaseDirectory, "data", "Uploads");
        Directory.CreateDirectory(uploadsDir);
        var savedPath = Path.Combine(uploadsDir, $"{Guid.NewGuid()}-{file.Name}");

        try
        {
            await using (var stream = file.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024))
            await using (var fileStream = File.Create(savedPath))
            {
                await stream.CopyToAsync(fileStream);
            }

            if (isImage)
            {
                // Downscaled/re-encoded copy saved permanently now, not just
                // before sending - a reloaded session's persisted copy is
                // already the small version, nothing reprocesses it again.
                _pendingAttachedImagePath = ImageAttachmentService.SaveResizedCopy(savedPath);
                _pendingAttachedFileName = file.Name;
            }
            else
            {
                _pendingAttachedFileText = FileTextExtractor.ExtractText(savedPath);
                _pendingAttachedFileName = file.Name;
            }
        }
        catch (Exception ex)
        {
            _attachError = $"Couldn't read '{file.Name}': {ex.Message}";
        }
        finally
        {
            File.Delete(savedPath);
        }

        StateHasChanged();
    }

    private void RemovePendingAttachment()
    {
        if (_pendingAttachedImagePath is not null)
        {
            try { File.Delete(_pendingAttachedImagePath); } catch { /* best-effort - orphaned file cleanup only */ }
        }
        _pendingAttachedFileText = null;
        _pendingAttachedImagePath = null;
        _pendingAttachedFileName = null;
    }

    /// <summary>Non-null when an image is attached but the currently selected model isn't vision-labeled - blocks Send and shows an inline warning, matching the desktop apps' own design.</summary>
    private string? AttachedImageVisionWarningText =>
        _pendingAttachedImagePath is not null && !_modelVisionSupport.GetValueOrDefault(_selectedModel, false)
            ? "The selected model doesn't support image input - pick a vision-capable model or remove the attached image."
            : null;

    // Called from wwwroot/lemon.js when Enter (without Shift) is pressed in
    // the chat box - Shift+Enter inserts a newline instead.
    [JSInvokable]
    public async Task OnEnterPressed()
    {
        await InvokeAsync(async () =>
        {
            if (!string.IsNullOrWhiteSpace(_inputText) && !_isBusy && !_isLoadingModel && AttachedImageVisionWarningText is null)
            {
                await SendAsync();
            }
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfReference = DotNetObjectReference.Create(this);
            try { await JS.InvokeVoidAsync("lemon.initChatInput", _inputBox, _selfReference); } catch (JSException) { }
        }

        try
        {
            await JS.InvokeVoidAsync("lemon.autoGrow", _inputBox);
            if (_focusRenameInput)
            {
                _focusRenameInput = false;
                await _renameInput.FocusAsync();
            }
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException) { /* element not on screen right now */ }
    }

    /// <summary>Compact "how long ago" for the chat list: now, 5m, 3h, Yesterday, 4d, then a short date.</summary>
    private static string RelativeTime(DateTime utc)
    {
        var age = DateTime.UtcNow - utc.ToUniversalTime();
        if (age.TotalMinutes < 1) return "now";
        if (age.TotalHours < 1) return $"{(int)age.TotalMinutes}m";
        if (age.TotalDays < 1) return $"{(int)age.TotalHours}h";
        var local = utc.ToLocalTime();
        if (local.Date == DateTime.Today.AddDays(-1)) return "Yesterday";
        if (age.TotalDays < 7) return $"{(int)age.TotalDays}d";
        return local.ToString("d MMM");
    }

    private void BeginRename(ChatSessionSummary session)
    {
        _openMenuSessionId = null;
        _renamingSessionId = session.Id;
        _renameText = session.Title;
        _focusRenameInput = true;
    }

    private async Task OnRenameKeyDownAsync(KeyboardEventArgs e, string sessionId)
    {
        if (e.Key == "Enter") await CommitRenameAsync(sessionId);
        else if (e.Key == "Escape") _renamingSessionId = null;
    }

    private async Task CommitRenameAsync(string sessionId)
    {
        // Escape (or an earlier commit) already ended the edit - the blur
        // that follows the input disappearing must not re-save.
        if (_renamingSessionId != sessionId) return;
        _renamingSessionId = null;

        var title = string.IsNullOrWhiteSpace(_renameText) ? "New chat" : _renameText.Trim();
        SessionRepository.RenameSession(sessionId, title);
        RefreshSessions();
        await InvokeAsync(StateHasChanged);
    }

    private async Task AddTagAsync(string sessionId)
    {
        if (string.IsNullOrWhiteSpace(_newTagText)) return;
        SessionRepository.AddTagToSession(sessionId, _newTagText.Trim());
        _newTagText = "";
        RefreshSessions();
        await InvokeAsync(StateHasChanged);
    }

    private async Task CopyTextAsync(string text)
    {
        try { await JS.InvokeVoidAsync("lemon.copyText", text); } catch (JSException) { /* clipboard blocked (needs https or localhost) */ }
    }

    private async Task CopyImageAsync(string url)
    {
        try { await JS.InvokeVoidAsync("lemon.copyImage", url); } catch (JSException) { /* clipboard blocked (needs https or localhost) */ }
    }

    private async Task SendAsync()
    {
        var userText = _inputText.Trim();
        if (string.IsNullOrWhiteSpace(userText) || _isBusy) return;

        var isFirstMessage = _messages.Count == 0;

        _inputText = "";
        _isBusy = true;

        // _history[0] only gets the STABLE refresh here (see
        // RefreshStableSystemPrompt's own comment on why). This turn's
        // relevant-memories/knowledge-base text, plus the current date/time
        // (TimeAwareness - a local model has no other way to know it),
        // never goes into _history at all - it's folded into just the
        // outgoing copy of the newest message further below via
        // AppendVolatileContext. When the Knowledge module IS enabled,
        // knowledgeText is fetched unconditionally (not gated on a KB
        // actually being attached) - GetRelevantChunksTextAsync's own
        // explicit "no knowledge base is attached" text when none is
        // matters just as much as the chunks themselves (silence
        // here gets misread by the model). When the module is disabled, that call (and its boilerplate text)
        // is skipped entirely rather than fetched and then discarded.
        //
        // (The volatile text and stable-prompt refresh now happen further
        // down, after the image-model check - nothing LLM-specific should be
        // spent on a turn that goes straight to image generation.)

        // A one-off attached file's extracted text is folded into
        // what's actually SENT to the model (textForModel), never into the
        // visible bubble - otherwise a multi-thousand-character PDF dump
        // would flood the transcript. The bubble shows just the typed
        // question plus a small "📎 filename" chip. What's persisted is the
        // combined text too (matches what was actually sent) - a reloaded
        // session shows the full text in the bubble, less pretty but honest.
        //
        // An attached image is persisted differently: the real
        // DataContent bytes can't live in a TEXT column, so the string form
        // is a "[Attached image: {path}]" marker + blank line + the plain
        // question (LoadSession parses this back out via
        // ImageAttachmentService.TryParseAttachedImageMarker to rebuild a
        // real multi-content message). The LIVE _history entry sent to the
        // model this turn skips the marker text entirely - just the plain
        // question plus the real image bytes, so the model never sees
        // literal marker syntax.
        string textForModel;
        string? attachedImageUrl = null;
        ChatMessage userChatMessage;
        if (_pendingAttachedImagePath is not null)
        {
            textForModel = $"[Attached image: {_pendingAttachedImagePath}]\n\n{userText}";
            attachedImageUrl = ToAttachedImageUrl(_pendingAttachedImagePath);
            userChatMessage = new ChatMessage(ChatRole.User, [new TextContent(userText), ImageAttachmentService.BuildDataContent(_pendingAttachedImagePath)]);
        }
        else if (_pendingAttachedFileText is not null)
        {
            // The filename marker tells the model what the pasted text is -
            // same shape as the Avalonia app's textForModel.
            textForModel = $"[Attached file: {_pendingAttachedFileName}]\n\n{_pendingAttachedFileText}\n\n{userText}";
            userChatMessage = new ChatMessage(ChatRole.User, textForModel);
        }
        else
        {
            textForModel = userText;
            userChatMessage = new ChatMessage(ChatRole.User, textForModel);
        }

        var attachedFileName = _pendingAttachedFileName;
        _pendingAttachedFileText = null;
        _pendingAttachedImagePath = null;
        _pendingAttachedFileName = null;

        var userMessage = new DisplayMessage { IsUser = true, Text = userText, AttachedFileName = attachedFileName, AttachedImageUrl = attachedImageUrl };
        _messages.Add(userMessage);
        SetDateDividerIfNeeded(userMessage);
        _history.Add(userChatMessage);
        SessionRepository.SaveMessage(_currentSessionId, ChatRole.User.Value, textForModel, reasoningContent: null);

        if (isFirstMessage)
        {
            var title = userText.Length > 60 ? string.Concat(userText.AsSpan(0, 60), "...") : userText;
            SessionRepository.RenameSession(_currentSessionId, title);
            RefreshSessions();
        }

        var assistantMessage = new DisplayMessage { IsUser = false };
        _messages.Add(assistantMessage);
        SetDateDividerIfNeeded(assistantMessage);
        StateHasChanged();

        // A single stuck/looping completion otherwise has nothing
        // bounding it (Lemonade has been seen running a request past 80,000+
        // output tokens with no end in sight), and _sendCts gives the Stop
        // button above something real to cancel.
        const int maxOutputTokensPerReply = 16384;
        var cts = new CancellationTokenSource();
        _sendCts = cts;

        // Selecting an image-labeled model directly skips the LLM entirely
        // for this turn (as Lemonade's own web UI does) - avoids a confusing
        // HTTP 400 from using an image model as the chat model.
        if (_modelCategories.GetValueOrDefault(_selectedModel) == ModelCategoryImage)
        {
            await SendImageGenerationTurnAsync(userText, assistantMessage, cts.Token);
            _sendCts = null;
            _isBusy = false;
            StateHasChanged();
            return;
        }

        // _history[0] only gets the STABLE refresh (see
        // RefreshStableSystemPrompt); this turn's time/memory/knowledge text
        // never goes into _history, only into the outgoing copy below.
        var volatileContextText = await BuildLiveTurnContextTextAsync(userText);
        RefreshStableSystemPrompt();

        var fullReply = new System.Text.StringBuilder();
        var fullReasoning = new System.Text.StringBuilder();
        var wasCancelled = false;
        var hadError = false;
        var options = new ChatOptions { ModelId = _selectedModel, Tools = ModuleRegistry.GetEnabledTools(), MaxOutputTokens = maxOutputTokensPerReply };

        // Prompt-processing progress indicator. llama.cpp's own
        // server reports a "prompt_progress" field while it's still
        // processing the (possibly huge) input context, before generating a
        // single output token - genuinely useful on a long prompt/knowledge-
        // base-attached turn, where several seconds of apparent silence
        // otherwise looks identical to "stuck". return_progress isn't part
        // of the OpenAI-compatible schema Microsoft.Extensions.AI/the OpenAI
        // SDK know about, so it has to be patched directly into the raw
        // outgoing request via RawRepresentationFactory - confirmed this
        // exact mechanism (ChatCompletionOptions.Patch, UTF8-byte-keyed
        // JSON paths) against this project's own installed SDK via
        // PowerShell reflection before writing this, not assumed from the
        // Avalonia port's own already-verified findings.
#pragma warning disable SCME0001
        options.RawRepresentationFactory = _ =>
        {
            var raw = new OpenAI.Chat.ChatCompletionOptions();
            raw.Patch.Set("$.return_progress"u8, true);
            return raw;
        };
#pragma warning restore SCME0001
        var promptProgressStopwatch = new System.Diagnostics.Stopwatch();

        // StripOldImageContent's result, not _history itself. The
        // real per-message DataContent stays in _history permanently
        // (LoadSession needs to reconstruct it later so the newest image can
        // still be resent), but an old image costs real tokens for no
        // benefit once it's not the current turn - only the single most
        // recent image-bearing message keeps its real bytes in what's
        // actually sent.
        //
        // AppendVolatileContext layers this turn's volatile
        // context (see above) onto that same outgoing copy, never onto
        // _history itself.
        var outgoingMessages = AppendVolatileContext(StripOldImageContent(_history), volatileContextText);
        try
        {
            await foreach (var update in ChatClient.GetStreamingResponseAsync(outgoingMessages, options, cts.Token))
            {
                fullReply.Append(update.Text);
                assistantMessage.Text = fullReply.ToString();

                foreach (var content in update.Contents)
                {
                    if (content is TextReasoningContent reasoning)
                    {
                        fullReasoning.Append(reasoning.Text);
                        assistantMessage.ReasoningText = fullReasoning.ToString();
                    }
                    else if (content is FunctionCallContent functionCall && !assistantMessage.ToolCalls.Any(t => t.CallId == functionCall.CallId))
                    {
                        assistantMessage.ToolCalls.Add(new ToolCallResult { Name = functionCall.Name, CallId = functionCall.CallId });
                    }
                    else if (content is FunctionResultContent functionResult)
                    {
                        var matchingCall = assistantMessage.ToolCalls.FirstOrDefault(t => t.CallId == functionResult.CallId);
                        if (matchingCall is not null)
                        {
                            matchingCall.Succeeded = functionResult.Exception is null;
                            matchingCall.ErrorMessage = functionResult.Exception?.Message;
                        }
                    }
                }

                // Only meaningful before any real answer/reasoning
                // text has arrived yet; cleared the instant either one
                // starts (a real token means prompt processing is over).
                if (fullReply.Length == 0 && fullReasoning.Length == 0)
                {
#pragma warning disable SCME0001
                    if (update.RawRepresentation is OpenAI.Chat.StreamingChatCompletionUpdate rawUpdate
                        && rawUpdate.Patch.Contains("$.prompt_progress"u8)
                        && rawUpdate.Patch.TryGetValue("$.prompt_progress.total"u8, out int promptTotal)
                        && rawUpdate.Patch.TryGetValue("$.prompt_progress.processed"u8, out int promptProcessed))
                    {
                        rawUpdate.Patch.TryGetValue("$.prompt_progress.cache"u8, out int promptCache);
                        var effectiveTotal = promptTotal - promptCache;
                        var effectiveProcessed = promptProcessed - promptCache;
                        if (effectiveTotal > 0)
                        {
                            if (!promptProgressStopwatch.IsRunning) promptProgressStopwatch.Start();
                            var percent = (int)Math.Round(100.0 * effectiveProcessed / effectiveTotal);
                            var etaText = "";
                            if (promptProgressStopwatch.ElapsedMilliseconds > 500 && effectiveProcessed > 0)
                            {
                                var rate = effectiveProcessed / (promptProgressStopwatch.ElapsedMilliseconds / 1000.0);
                                var remainingSeconds = (int)Math.Round(Math.Max(0, (effectiveTotal - effectiveProcessed) / rate));
                                etaText = $" (ETA: {remainingSeconds}s)";
                            }
                            assistantMessage.PromptProgressText = $"Processing prompt: {percent}%{etaText}";
                        }
                    }
#pragma warning restore SCME0001
                }
                else if (assistantMessage.PromptProgressText is not null)
                {
                    assistantMessage.PromptProgressText = null;
                }

                StateHasChanged();
            }
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
            // Keeps whatever text/reasoning had already streamed in rather
            // than discarding it - a partial answer the user watched arrive
            // is still worth keeping.
            wasCancelled = true;
            if (fullReply.Length > 0) fullReply.Append(' ');
            fullReply.Append("[Stopped]");
            assistantMessage.Text = fullReply.ToString();
        }
        catch (Exception ex)
        {
            hadError = true;
            fullReply.Clear();
            fullReply.Append($"⚠️ Something went wrong generating a reply: {ex.Message}");
            assistantMessage.Text = fullReply.ToString();
        }
        finally
        {
            _sendCts = null;
        }

        // Safety net: a cancelled or errored reply might never
        // reach the streaming loop's own "real text/reasoning arrived"
        // clear, so a stuck "43%" could otherwise linger forever.
        assistantMessage.PromptProgressText = null;

        var replyText = fullReply.ToString();
        assistantMessage.GeneratedImageUrl = TryExtractGeneratedImageUrl(replyText);
        if (assistantMessage.GeneratedImageUrl is not null)
        {
            // The raw ![alt](file:///...) Markdown stays in replyText (what's
            // actually persisted/sent back to the model - LoadSession's own
            // regex needs it there on reload), but showing that literal text
            // in the bubble on top of the real rendered image below it is
            // just noise - strip it from what's actually displayed.
            assistantMessage.Text = StripGeneratedImageMarkdown(replyText);
        }
        // A failed turn's error text is shown but never added to the model's
        // history or saved - it isn't a real reply (same as the Avalonia app).
        if (!hadError)
        {
            _history.Add(new ChatMessage(ChatRole.Assistant, replyText));
            SessionRepository.SaveMessage(_currentSessionId, ChatRole.Assistant.Value, replyText,
                reasoningContent: fullReasoning.Length > 0 ? fullReasoning.ToString() : null,
                toolCalls: assistantMessage.ToolCalls.Count > 0 ? string.Join(",", assistantMessage.ToolCalls.Select(t => t.SerializeForStorage())) : null);
        }

        // Auto-tag sidebar refresh. "scheduled" tagging is done in
        // ScheduledJobRunner.RunJobAsync; these cases are tagged here. Each AddTagToSession call is immediately
        // followed by its own RefreshSessions() - not batched at the end -
        // because a live ChatSessionSummary's Tags collection is only
        // populated once, when first loaded: adding a tag to the DB without
        // a refresh leaves the sidebar chip invisible until some unrelated
        // later refresh (e.g. switching chats).
        if (assistantMessage.ToolCalls.Any(t => t.Name == "generate_image"))
        {
            SessionRepository.AddTagToSession(_currentSessionId, "image");
            RefreshSessions();
        }
        if (assistantMessage.ToolCalls.Any(t => t.Name.StartsWith("code_", StringComparison.OrdinalIgnoreCase)))
        {
            SessionRepository.AddTagToSession(_currentSessionId, "coder");
            RefreshSessions();
        }
        if (assistantMessage.ToolCalls.Any(t => ModuleRegistry.IsToolFromModule(t.Name, "Mcp")))
        {
            SessionRepository.AddTagToSession(_currentSessionId, "mcp");
            RefreshSessions();
        }

        // Stats, fact extraction and compaction are skipped on a stopped or
        // failed reply - nothing meaningful to measure or learn from a
        // deliberately-interrupted/errored turn (same as the Avalonia app).
        if (!wasCancelled && !hadError)
        {
            // Fire-and-forget - a separate tools-free
            // structured-output call (Lemonade can't combine tools + structured
            // output in one call), so it must never block the turn that's
            // already been shown to the user.
            _ = MemoryService.ExtractAndSaveFactsAsync(userText, replyText, CancellationToken.None);

            await RefreshStatsAsync();
            await CompactHistoryIfNeededAsync(assistantMessage);
        }
        await RefreshHealthAsync();

        _isBusy = false;
        StateHasChanged();
    }

    private void StopGeneration() => _sendCts?.Cancel();

    /// <summary>
    /// The direct-image-model-selection path (an image-labeled model picked in
    /// the dropdown): asks for a size via the same ImageSizeGate overlay the
    /// generate_image tool uses, generates with the SELECTED model, and shows
    /// the result like any other generated image. Shares ImageGenerationService
    /// with the tool path.
    /// </summary>
    private async Task SendImageGenerationTurnAsync(string prompt, DisplayMessage assistantMessage, CancellationToken cancellationToken)
    {
        string replyText;
        var sizeChoice = await ImageSizeGate.RequestSizeAsync(prompt, Settings.ImageGen.DefaultWidth, Settings.ImageGen.DefaultHeight);
        if (!sizeChoice.Confirmed)
        {
            replyText = "(Cancelled - no image was generated.)";
        }
        else
        {
            try
            {
                var imageUri = await ImageGenerationService.GenerateAsync(
                    prompt, _selectedModel, sizeChoice.Width, sizeChoice.Height,
                    Settings.ImageGen.Steps, Settings.ImageGen.CfgScale, Settings.ImageGen.Seed,
                    cancellationToken);

                var altText = prompt.Length > 80 ? prompt[..80] + "..." : prompt;
                replyText = $"![{altText}]({imageUri})";

                SessionRepository.AddTagToSession(_currentSessionId, "image");
                RefreshSessions();
            }
            catch (OperationCanceledException)
            {
                replyText = "[Stopped]";
            }
            catch (Exception ex)
            {
                replyText = $"⚠️ Couldn't generate that image: {ex.Message}";
            }
        }

        assistantMessage.GeneratedImageUrl = TryExtractGeneratedImageUrl(replyText);
        assistantMessage.Text = assistantMessage.GeneratedImageUrl is not null ? StripGeneratedImageMarkdown(replyText) : replyText;
        _history.Add(new ChatMessage(ChatRole.Assistant, replyText));
        SessionRepository.SaveMessage(_currentSessionId, ChatRole.Assistant.Value, replyText, reasoningContent: null);
    }

    // generate_image's own tool result tells the model to include
    // ready-made Markdown image syntax (![alt](file:///...)) in its reply;
    // this extracts that path back out and converts it to the web-relative
    // URL Program.cs's own static-file mapping serves it under, rather than
    // pulling in a full Markdown rendering pipeline just for this one case.
    private static readonly System.Text.RegularExpressions.Regex GeneratedImageLinkPattern =
        new(@"!\[[^\]]*\]\((file:///?[^)\s]+)\)", System.Text.RegularExpressions.RegexOptions.Compiled);

    private static string? TryExtractGeneratedImageUrl(string replyText)
    {
        var match = GeneratedImageLinkPattern.Match(replyText);
        if (!match.Success) return null;

        try
        {
            var localPath = new Uri(match.Groups[1].Value).LocalPath;
            return $"/generated-images/{Uri.EscapeDataString(Path.GetFileName(localPath))}";
        }
        catch (UriFormatException)
        {
            return null;
        }
    }

    /// <summary>Removes the raw Markdown image link from displayed bubble text - the real <img> already shows it, so the literal "![alt](file:///...)" text is just clutter, not useful content.</summary>
    private static string StripGeneratedImageMarkdown(string text) => GeneratedImageLinkPattern.Replace(text, "").Trim();

    /// <summary>Converts an AttachedImages local path to the web-relative URL Program.cs's own static-file mapping serves it under - same shape as TryExtractGeneratedImageUrl's own conversion, just for a path already known rather than regex-extracted.</summary>
    private static string ToAttachedImageUrl(string localPath) => $"/attached-images/{Uri.EscapeDataString(Path.GetFileName(localPath))}";

    // Markdown rendering in the chat transcript. DisableHtml()
    // is deliberate, not an oversight: a reply can legitimately contain
    // text pulled from the open web (search_web/read_webpage results), and
    // letting raw HTML in a Markdown document pass through verbatim into
    // the page would be a real XSS vector the moment a fetched page (or a
    // prompt-injected instruction inside one) contained a <script> tag -
    // disabling it means any literal "<...>" in the text is escaped and
    // shown as plain text instead of parsed as markup. UseSoftlineBreakAsHardlineBreak
    // treats a single newline as a real line break rather than requiring a
    // blank line between them per strict CommonMark - closer to how a chat
    // model actually formats its own output.
    private static readonly MarkdownPipeline ChatMarkdownPipeline = new MarkdownPipelineBuilder()
        .UseSoftlineBreakAsHardlineBreak()
        .DisableHtml()
        .Build();

    private static MarkupString RenderMarkdown(string? text) =>
        (MarkupString)Markdown.ToHtml(text ?? "", ChatMarkdownPipeline);

    /// <summary>Non-mutating - drops every older message's DataContent except the single most recent one, so an old image doesn't cost real tokens on every later turn once it's no longer the current question. _history itself (passed in by value, never reassigned) keeps every image's real bytes permanently.</summary>
    private static List<ChatMessage> StripOldImageContent(List<ChatMessage> history)
    {
        var lastImageIndex = -1;
        for (var i = 0; i < history.Count; i++)
        {
            if (history[i].Contents.Any(c => c is DataContent)) lastImageIndex = i;
        }

        if (lastImageIndex < 0) return history;

        var result = new List<ChatMessage>(history.Count);
        for (var i = 0; i < history.Count; i++)
        {
            if (i == lastImageIndex || !history[i].Contents.Any(c => c is DataContent))
            {
                result.Add(history[i]);
            }
            else
            {
                var textOnly = history[i].Contents.Where(c => c is not DataContent).ToList();
                result.Add(new ChatMessage(history[i].Role, textOnly));
            }
        }
        return result;
    }

    private async Task RefreshStatsAsync()
    {
        try
        {
            var stats = await ManagementClient.GetStatsAsync(CancellationToken.None);
            if (stats is not null)
            {
                _lastInputTokens = stats.InputTokens;
                _lastOutputTokens = stats.OutputTokens;
                _lastTokensPerSecond = stats.TokensPerSecond;
                _lastTimeToFirstToken = stats.TimeToFirstToken;
                _sessionTotalInputTokens += stats.InputTokens;
                _sessionTotalOutputTokens += stats.OutputTokens;
                _contextUsageCurrent = stats.PromptTokens;
            }
        }
        catch
        {
            // Best-effort - a failed stats fetch doesn't blow up a reply the user already received.
        }
    }

    /// <summary>
    /// Hand-rolled short-term memory / context compaction - once context
    /// usage crosses CompactionTriggerPercent of the model's real max
    /// context window, summarizes everything older than the most-recent
    /// MessagesToKeepAfterCompaction messages into a running summary and
    /// drops them from _history (the visible Messages/persisted transcript
    /// are untouched - only what's sent to the model shrinks).
    ///
    /// This used to run completely silently, with no way for the
    /// user to know their history was just summarized/trimmed - a bigger,
    /// more basic gap than it first looked (not even an "after it's done"
    /// note existed). Now adds an in-progress note to the turn's own
    /// assistantMessage bubble before the summarization call starts (itself
    /// a full model round-trip that can take a while), replacing it with a
    /// final "saved ~N tokens" note on success, or removing it silently on
    /// failure.
    /// </summary>
    private async Task CompactHistoryIfNeededAsync(DisplayMessage assistantMessage)
    {
        if (_contextUsageMax <= 0 || _contextUsageCurrent is null) return;
        if ((double)_contextUsageCurrent.Value / _contextUsageMax < Settings.Memory.CompactionTriggerPercent / 100.0) return;

        var compactibleCount = _history.Count - 1 - MessagesToKeepAfterCompaction;
        if (compactibleCount <= 0) return;

        const string inProgressNote = "Compacting older messages...";
        var tokensBeforeCompaction = _contextUsageCurrent.Value;
        assistantMessage.SystemNotes.Add(inProgressNote);
        StateHasChanged();

        try
        {
            var itemsToSummarize = new List<ChatMessage>();
            if (!string.IsNullOrEmpty(_conversationSummaryText))
            {
                itemsToSummarize.Add(new ChatMessage(ChatRole.System, $"Summary of even earlier conversation: {_conversationSummaryText}"));
            }
            itemsToSummarize.AddRange(_history.Skip(1).Take(compactibleCount));

            _conversationSummaryText = await CompactionService.SummarizeAsync(itemsToSummarize, CancellationToken.None);

            var keptTail = _history.Skip(_history.Count - MessagesToKeepAfterCompaction).ToList();
            _history.Clear();
            RefreshStableSystemPrompt();
            _history.AddRange(keptTail);

            // A rough ~4-chars-per-token estimate, marked as approximate -
            // _contextUsageCurrent otherwise stays at its last real
            // Lemonade-reported figure until the next turn's own stats
            // come back, which would read as "compaction did nothing"
            // since the number wouldn't move.
            var estimatedChars = _history.Sum(m => (m.Text ?? "").Length);
            _contextUsageCurrent = Math.Max(1, estimatedChars / 4);

            assistantMessage.SystemNotes.Remove(inProgressNote);
            var savedTokens = Math.Max(0, tokensBeforeCompaction - _contextUsageCurrent.Value);
            assistantMessage.SystemNotes.Add($"Compacted older messages - saved ~{savedTokens:N0} tokens");
            _compactionCount++;
        }
        catch
        {
            // Best-effort - a failed compaction attempt just means the next
            // turn's request stays as large as it already was. Remove the
            // in-progress note rather than leaving it stuck forever.
            assistantMessage.SystemNotes.Remove(inProgressNote);
        }
    }

    public void Dispose()
    {
        _searchDebounceCts?.Cancel();
        _sendCts?.Cancel();
        _connectionRetryTimer?.Dispose();
        ApprovalGate.OnPendingRequestChanged -= OnPendingApprovalChanged;
        SchedulerNotifier.SessionUpdated -= OnSchedulerSessionUpdated;
        ImageSizeGate.OnPendingRequestChanged -= OnPendingImageSizeChanged;
        _selfReference?.Dispose();
    }
}
