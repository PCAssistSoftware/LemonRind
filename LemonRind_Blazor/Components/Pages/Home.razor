    // Blazor-native image-size confirmation overlay, same
    // subscribe-at-init/unsubscribe-on-Dispose pattern as the approval
    // overlay above, via ImageSizeGate.
    private ImageSizeRequest? _pendingImageSize;
    private int _imageSizeWidth;
    private int _imageSizeHeight;

    private void OnPendingImageSizeChanged(ImageSizeRequest? request)
