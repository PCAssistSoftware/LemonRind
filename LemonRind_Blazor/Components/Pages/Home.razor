    private void NewChat()
    {
        _sidebarOpen = false;
        _currentSessionId = SessionRepository.CreateSession("New chat");
        _history.Clear();
        _messages.Clear();
        _conversationSummaryText = "";
        _contextUsageCurrent = null;
        _attachedKnowledgeBaseId = "";
        _compactionCount = 0;
        _sessionTotalInputTokens = 0;
        _sessionTotalOutputTokens = 0;
        _openMenuSessionId = null;
        RefreshStableSystemPrompt();
        RefreshSessions();
    }

    // Scheduler. forceReload lets OnSchedulerSessionUpdated re-pull
    // a session's messages even when it's already the one open (a job's
    // "running in background" note, then its real reply, both land on a
    // session that was already current before either was saved).
    // Narrow-window drawers: whether the chat list / the Stats panel is slid in.
    private bool _sidebarOpen;
    private bool _statsOpen;
    private void ToggleSidebar() { _sidebarOpen = !_sidebarOpen; _statsOpen = false; }
    private void ToggleStats() { _statsOpen = !_statsOpen; _sidebarOpen = false; }
    private void CloseDrawers() { _sidebarOpen = false; _statsOpen = false; }

    private void LoadSession(string sessionId, bool forceReload = false)
    {
        _sidebarOpen = false;
        if (sessionId == _currentSessionId && !forceReload) return;

        _currentSessionId = sessionId;
        _history.Clear();
        _messages.Clear();
        _conversationSummaryText = "";
        _contextUsageCurrent = null;
        _attachedKnowledgeBaseId = SessionRepository.GetAttachedKnowledgeBase(sessionId) ?? "";
        _compactionCount = 0;
        _sessionTotalInputTokens = 0;
        _sessionTotalOutputTokens = 0;
        _openMenuSessionId = null;

        // _history[0] is always reserved for the system message - seeded
        // here so index 0 stays reserved before the real stored messages
        // are appended after it. Only the stable portion is rebuilt (see
        // RefreshStableSystemPrompt's own comment) - there's no new user
        // input yet to derive this turn's volatile context from anyway.
        RefreshStableSystemPrompt();

        foreach (var stored in SessionRepository.LoadMessages(sessionId))
        {
            var isUser = string.Equals(stored.Role, ChatRole.User.Value, StringComparison.OrdinalIgnoreCase);
            var displayMessage = new DisplayMessage { IsUser = isUser, Text = stored.Content, ReasoningText = stored.ReasoningContent ?? "", CreatedAt = stored.CreatedAt.ToLocalTime() };

            if (isUser)
            {
                // An image-attached turn's persisted content starts
                // with the "[Attached image: {path}]" marker (see SendAsync's
                // own comment on why DataContent can't live in the TEXT
                // column directly) - parsed back out here to rebuild a real
                // multi-content message so the newest image can still be
                // resent, and to restore the bubble's own thumbnail. Falls
                // back to text-only if the local copy no longer exists on
                // disk - the image is lost, but the question text isn't.
                var (imagePath, remainingText) = ImageAttachmentService.TryParseAttachedImageMarker(stored.Content);
                if (imagePath is not null && File.Exists(imagePath))
                {
                    displayMessage.Text = remainingText;
                    displayMessage.AttachedImageUrl = ToAttachedImageUrl(imagePath);
                    // The markup's thumbnail is gated on AttachedFileName being
                    // non-empty (same condition a document attachment's chip
                    // uses) - the original picked filename isn't part of the
                    // persisted marker, so the processed copy's own filename
                    // stands in for it. Without this, the image
                    // reconstructs correctly but its thumbnail silently never
                    // renders.
                    displayMessage.AttachedFileName = Path.GetFileName(imagePath);
                    _history.Add(new ChatMessage(ChatRole.User, [new TextContent(remainingText), ImageAttachmentService.BuildDataContent(imagePath)]));
                }
                else if (imagePath is not null)
                {
                    displayMessage.Text = remainingText;
                    _history.Add(new ChatMessage(ChatRole.User, remainingText));
                }
                else
                {
                    _history.Add(new ChatMessage(ChatRole.User, stored.Content));
                }
            }
            else
            {
                _history.Add(new ChatMessage(ChatRole.Assistant, stored.Content));
            }

            if (!string.IsNullOrEmpty(stored.ToolCalls))
            {
                displayMessage.ToolCalls.AddRange(stored.ToolCalls.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(ToolCallResult.ParseFromStorage));
            }
            if (!isUser)
            {
                displayMessage.GeneratedImageUrl = TryExtractGeneratedImageUrl(stored.Content);
                if (displayMessage.GeneratedImageUrl is not null)
                {
                    displayMessage.Text = StripGeneratedImageMarkdown(stored.Content);
                }
            }
            _messages.Add(displayMessage);
            SetDateDividerIfNeeded(displayMessage);
        }
    }

    /// <summary>
    /// Rebuilds _history[0] from the STABLE portions only: base
    /// system prompt + running compaction summary (if any) + pinned facts.
    /// Deliberately excludes this turn's relevant-memories/knowledge-base
    /// text and the current date/time (see AppendVolatileContext below) -
    /// those change on every single turn, so mixing them into _history[0]
    /// would rewrite that system message (position 0) on every single turn. That
    /// defeats llama.cpp's KV-cache prefix reuse: nothing in the whole
    /// request can be cached once position 0 itself changes, even when the
    /// rest of the conversation is unchanged. Called from NewChat/
    /// LoadSession/SendAsync/CompactHistoryIfNeededAsync so the stable
    /// prompt is correct the moment a chat opens, not just after the first
    /// message is sent.
    /// </summary>
    private void RefreshStableSystemPrompt()
    {
        var sections = new List<string>();

        // Persona. Identity/AboutUser come before the operating
        // instructions (SystemPrompt) - "who am I / who are you talking to"
        // reads naturally before "how should you behave". Both are omitted
        // entirely when unset, same as every other section here, so an
        // unconfigured Persona costs nothing in prompt size.
        var persona = Settings.Persona;
        if (!string.IsNullOrWhiteSpace(persona.Identity)) sections.Add(persona.Identity);
        if (!string.IsNullOrWhiteSpace(persona.AboutUser)) sections.Add($"About the person you're talking to:\n{persona.AboutUser}");

        sections.Add(Settings.Assistant.SystemPrompt);

        var writingStyleText = BuildWritingStyleText();
        if (!string.IsNullOrEmpty(writingStyleText)) sections.Add(writingStyleText);

        if (!string.IsNullOrEmpty(_conversationSummaryText)) sections.Add($"Summary of earlier conversation: {_conversationSummaryText}");

        var pinnedFactsText = MemoryService.GetPinnedFactsText();
        if (!string.IsNullOrEmpty(pinnedFactsText)) sections.Add(pinnedFactsText);

        var systemMessage = new ChatMessage(ChatRole.System, string.Join("\n\n", sections));
        if (_history.Count == 0) _history.Add(systemMessage);
        else _history[0] = systemMessage;
    }

    /// <summary>
    /// Compiles Persona's structured writing-style settings into
    /// compact bullet lines - cheap (a handful of tokens) but has an
    /// outsized effect on how the reply actually reads. Returns null (not
    /// an empty string) when every setting is still "Default" and no custom
    /// instructions are set, so RefreshStableSystemPrompt's IsNullOrEmpty
    /// check correctly omits this section entirely for an unconfigured
    /// Persona.
    /// </summary>
    private string? BuildWritingStyleText()
    {
        var persona = Settings.Persona;
        var lines = new List<string>();

        if (persona.Tone != "Default") lines.Add($"Tone: {persona.Tone}");
        if (persona.Verbosity != "Default") lines.Add($"Verbosity: {persona.Verbosity}");
        if (persona.EmojiUsage != "Default") lines.Add($"Emoji use: {persona.EmojiUsage}");
        if (!string.IsNullOrWhiteSpace(persona.CustomInstructions)) lines.Add(persona.CustomInstructions);

        if (lines.Count == 0) return null;

        return "Writing style:\n- " + string.Join("\n- ", lines);
    }

    /// <summary>
    /// Non-mutating. Folds this turn's volatile context (current
    /// date/time, semantically-relevant memories, knowledge-base chunks)
    /// into a COPY of just the newest outgoing message, as its own leading
    /// TextContent alongside whatever that message already carries (an
    /// attached image's real DataContent is untouched). Never written into
    /// _history itself and never persisted - a reload re-derives it fresh
    /// from whatever's actually relevant at reload time rather than reusing
    /// stale text baked into an old turn.
    /// </summary>
    private static List<ChatMessage> AppendVolatileContext(List<ChatMessage> messages, string volatileContextText)
    {
        if (messages.Count == 0 || string.IsNullOrEmpty(volatileContextText)) return messages;

        var result = new List<ChatMessage>(messages);
        var lastIndex = result.Count - 1;
        var last = result[lastIndex];
        var newContents = new List<AIContent> { new TextContent(volatileContextText) };
        newContents.AddRange(last.Contents);
        result[lastIndex] = new ChatMessage(last.Role, newContents);
        return result;
    }

    private void DeleteSession(string sessionId)
    {
        SessionRepository.DeleteSession(sessionId);
        if (sessionId == _currentSessionId)
        {
            RefreshSessions();
            if (_sessions.Count > 0) LoadSession(_sessions[0].Id);
            else NewChat();
        }
        else
        {
            RefreshSessions();
        }
    }

    private async Task OnModelChanged()
    {
        if (string.IsNullOrWhiteSpace(_selectedModel)) return;
        _isLoadingModel = true;
        _modelLoadError = null;
        _modelLoadSeconds = 0;
        StateHasChanged();

        var loadStopwatch = System.Diagnostics.Stopwatch.StartNew();
        using var loadTimer = new Timer(_ =>
        {
            _modelLoadSeconds = (int)loadStopwatch.Elapsed.TotalSeconds;
            _ = InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        try
        {
            await ManagementClient.LoadModelAsync(_selectedModel, CancellationToken.None);
        }
        catch (Exception ex)
        {
            _modelLoadError = $"Failed to load {_selectedModel}: {ex.Message}";
        }
        _contextUsageMax = _modelContextWindows.GetValueOrDefault(_selectedModel, 0);
        _isLoadingModel = false;
        StateHasChanged();
    }

