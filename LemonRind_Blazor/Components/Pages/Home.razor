@page "/"
@rendermode InteractiveServer
@using Markdig
@using Microsoft.Extensions.AI
@using LemonRindBlazor.Configuration
@using LemonRindBlazor.Data
@using LemonRindBlazor.Knowledge
@using LemonRindBlazor.Memories
@using LemonRindBlazor.Modules
@using LemonRindBlazor.Modules.FileSystem
@using LemonRindBlazor.Modules.ImageGen
@using LemonRindBlazor.Scheduler
@using LemonRindBlazor.Services
@inject IChatClient ChatClient
@inject LemonadeManagementClient ManagementClient
@inject ChatSessionRepository SessionRepository
@inject MemoryService MemoryService
@inject ConversationCompactionService CompactionService
@inject ModuleRegistry ModuleRegistry
@inject FileWriteApprovalGate ApprovalGate
@inject KnowledgeRepository KnowledgeRepository
@inject KnowledgeService KnowledgeService
@inject SchedulerNotifier SchedulerNotifier
@inject ImageSizeGate ImageSizeGate
@inject ImageAttachmentService ImageAttachmentService
@inject AppSettings Settings
@inject ImageGenerationService ImageGenerationService
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Lemon Rind (Blazor test)</PageTitle>

<div class="app-shell @(_sidebarOpen ? "nav-open" : "") @(_statsOpen ? "stats-open" : "")">
    @* Narrow windows: the chat list and the Stats/Modules panel become slide-in drawers (see the media queries in Home.razor.css). *@
    <div class="drawer-backdrop" @onclick="CloseDrawers"></div>
    <div class="sidebar">
        <button class="new-chat-btn" @onclick="NewChat"><Icon Name="plus" Size="15" /> New chat</button>
        <input class="search-box" placeholder="Search chats" @bind="_searchText" @bind:event="oninput" @bind:after="OnSearchChanged" />
        <div class="session-list">
            @foreach (var group in _sidebarGroups)
            {
                @if (group.Folder is not null)
                {
                    <div class="folder-header" @onclick="() => ToggleFolderCollapsedAsync(group.Folder)">
                        <span class="folder-chevron"><Icon Name="@(group.Folder.IsCollapsed ? "chevron-right" : "chevron-down")" Size="12" /></span>
                        <span class="folder-name">@group.Folder.Name</span>
                    </div>
                }
                else if (_folders.Count > 0)
                {
                    // Only shown once at least one real folder exists -
                    // otherwise everything is unfiled and the label would
                    // just be noise. Not collapsible (no FolderSummary to
                    // persist a collapsed state against) - plain label.
                    <div class="folder-header unfiled-header">
                        <span class="folder-name">Unfiled</span>
                    </div>
                }
                @if (group.Folder is null || !group.Folder.IsCollapsed)
                {
                    @foreach (var session in group.Sessions)
                    {
                        <div class="session-row @(session.Id == _currentSessionId ? "selected" : "")" @onclick="() => LoadSession(session.Id)">
                            <div class="session-main">
                                @if (_renamingSessionId == session.Id)
                                {
                                    <input class="session-rename-input" @ref="_renameInput" @bind="_renameText" @bind:event="oninput"
                                           @onclick:stopPropagation="true"
                                           @onkeydown="e => OnRenameKeyDownAsync(e, session.Id)"
                                           @onblur="() => CommitRenameAsync(session.Id)" />
                                }
                                else
                                {
                                    <div class="session-title-row">
                                        <span class="session-title">@session.Title</span>
                                        <span class="session-time" title="@session.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")">@RelativeTime(session.UpdatedAt)</span>
                                    </div>
                                }
                                @if (session.HasTags && _editingTagsSessionId != session.Id)
                                {
                                    <div class="session-tags">
                                        @foreach (var tag in session.Tags)
                                        {
                                            <span class="session-tag">@tag</span>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="session-actions" @onclick:stopPropagation="true">
                                <button class="session-menu-btn" title="More actions" @onclick="() => ToggleSessionMenu(session.Id)"><Icon Name="more" Size="16" /></button>
                                @if (_openMenuSessionId == session.Id)
                                {
                                    <div class="session-menu">
                                        <button @onclick="() => BeginRename(session)"><Icon Name="pencil" Size="14" /> Rename</button>
                                        <button @onclick="() => { ToggleFolderEditor(session.Id); _openMenuSessionId = null; }"><Icon Name="folder" Size="14" /> Move to folder</button>
                                        <button @onclick="() => { ToggleTagEditor(session.Id); _openMenuSessionId = null; }"><Icon Name="tag" Size="14" /> Tags</button>
                                        <a href="@($"/export/{session.Id}")" download @onclick="() => _openMenuSessionId = null"><Icon Name="download" Size="14" /> Export to Markdown</a>
                                        <button class="session-menu-delete" @onclick="() => { DeleteSession(session.Id); _openMenuSessionId = null; }"><Icon Name="trash" Size="14" /> Delete</button>
                                    </div>
                                }
                            </div>
                            @if (_editingFolderSessionId == session.Id)
                            {
                                <div class="inline-editor" @onclick:stopPropagation="true">
                                    <select @bind="_folderSelectValue">
                                        <option value="">(no folder)</option>
                                        @foreach (var f in _folders)
                                        {
                                            <option value="@f.Id">@f.Name</option>
                                        }
                                        <option value="__new__">+ New folder...</option>
                                    </select>
                                    @if (_folderSelectValue == "__new__")
                                    {
                                        <input @bind="_newFolderName" placeholder="Folder name" />
                                    }
                                    <button @onclick="() => ApplyFolderChangeAsync(session.Id)">Move</button>
                                    <button class="inline-editor-close" title="Close" @onclick="CloseFolderEditor"><Icon Name="x" Size="13" /></button>
                                </div>
                            }
                            @if (_editingTagsSessionId == session.Id)
                            {
                                <div class="inline-editor" @onclick:stopPropagation="true">
                                    @foreach (var tag in session.Tags.ToList())
                                    {
                                        <span class="session-tag editable">
                                            @tag
                                            <button class="tag-remove" @onclick="() => RemoveTagAsync(session.Id, tag)">&times;</button>
                                        </span>
                                    }
                                    <input @bind="_newTagText" @bind:event="oninput" @onkeydown="e => OnTagKeyDownAsync(e, session.Id)" placeholder="Add tag + Enter" />
                                    <button @onclick="() => AddTagAsync(session.Id)" disabled="@string.IsNullOrWhiteSpace(_newTagText)">Add</button>
                                    <button class="inline-editor-close" title="Done" @onclick="CloseTagEditor">Done</button>
                                </div>
                            }
                        </div>
                    }
                }
            }
        </div>
        <a href="/settings" class="sidebar-settings-link"><Icon Name="settings" Size="15" /> Settings</a>
    </div>

    <div class="resize-handle" data-var="--sidebar-w" data-side="left" title="Drag to resize - double-click to reset"></div>

    <div class="chat-container">
        <div class="header-row">
            <button class="icon-btn drawer-toggle nav-toggle" title="Chats" @onclick="ToggleSidebar"><Icon Name="menu" Size="18" /></button>
            <select @bind="_selectedModel" @bind:after="OnModelChanged" disabled="@(_isLoadingModel || _isBusy)">
                @foreach (var group in GroupedModels)
                {
                    <optgroup label="@group.Header">
                        @foreach (var model in group.Models)
                        {
                            <option value="@model">@model</option>
                        }
                    </optgroup>
                }
            </select>
            <button class="model-info-btn" title="Model details" disabled="@_isLoadingModel" @onclick="ShowModelDetailsAsync"><Icon Name="info" Size="17" /></button>
            @if (_isLoadingModel)
            {
                // Lemonade reports no real load progress (POST /v1/load just
                // blocks until the model is ready), so this is an
                // indeterminate bar plus an honest elapsed-seconds counter -
                // proof the app is working, not a predicted percentage.
                <span class="model-loading">
                    <span class="model-loading-bar"></span>
                    <span class="status-text">Loading @_selectedModel... @(_modelLoadSeconds)s - this can take a while for a large model</span>
                </span>
            }
            else if (!string.IsNullOrEmpty(_modelLoadError))
            {
                <span class="model-load-error">@_modelLoadError</span>
            }
            <span class="spacer"></span>
            @if (_contextUsageCurrent is not null && _contextUsageMax > 0)
            {
                <button class="status-text context-usage-btn" title="View context breakdown" @onclick="ShowContextBreakdownAsync">
                    @_contextUsageCurrent.Value.ToString("N0") / @_contextUsageMax.ToString("N0") tokens (@((int)Math.Round(100.0 * _contextUsageCurrent.Value / _contextUsageMax))%)
                </button>
            }
            <button class="health-indicator" @onclick="RetryConnectionAsync"
                    title="@(_isHealthy ? "Lemonade healthy" : _lastHealthCheckError ?? "Lemonade unreachable - click to retry")">
                <span class="health-dot @(_isHealthy ? "healthy" : "unhealthy")"></span>
                <span class="health-label">@(_isHealthy ? "Lemonade healthy" : "Lemonade unreachable")</span>
            </button>
            <button class="icon-btn drawer-toggle stats-toggle" title="Stats and modules" @onclick="ToggleStats"><Icon Name="panel-right" Size="18" /></button>
        </div>

        <div class="messages">
            @foreach (var message in _messages)
            {
                @if (!string.IsNullOrEmpty(message.DateDividerText))
                {
                    <div class="date-divider"><span>@message.DateDividerText</span></div>
                }
                <div class="message-row @(message.IsUser ? "user" : "assistant")">
                @if (!message.IsUser)
                {
                    @* Assistant avatar (the WPF app shows a robot here too) - an inline SVG (Lucide "bot", MIT) rather than the emoji, so it renders the same everywhere. *@
                    <span class="avatar" aria-hidden="true">
                        <Icon Name="bot" Size="16" />
                    </span>
                }
                <div class="bubble @(message.IsUser ? "user" : "assistant")" title="@message.CreatedAt.ToString("dd/MM/yyyy HH:mm")">
                    @if (message.IsUser && !string.IsNullOrEmpty(message.AttachedFileName))
                    {
                        @if (!string.IsNullOrEmpty(message.AttachedImageUrl))
                        {
                            <img class="attached-image" src="@message.AttachedImageUrl" alt="@message.AttachedFileName" />
                        }
                        else
                        {
                            <div class="attached-file-chip">📎 @message.AttachedFileName</div>
                        }
                    }
                    @if (!message.IsUser && !string.IsNullOrEmpty(message.PromptProgressText))
                    {
                        <div class="prompt-progress-text">@message.PromptProgressText</div>
                    }
                    @if (!message.IsUser && !string.IsNullOrEmpty(message.ReasoningText))
                    {
                        <details class="thinking" open="@Settings.Ui.ThinkingPanelOpenByDefault">
                            <summary>Thinking</summary>
                            <div class="thinking-text">@message.ReasoningText</div>
                        </details>
                    }
                    @if (!message.IsUser && message.SystemNotes.Count > 0)
                    {
                        <div class="system-note-chips">
                            @foreach (var note in message.SystemNotes)
                            {
                                <span class="system-note-chip">@note</span>
                            }
                        </div>
                    }
                    @if (!message.IsUser && message.ToolCalls.Count > 0)
                    {
                        <div class="tool-chips">
                            @foreach (var toolCall in message.ToolCalls)
                            {
                                <span class="tool-chip" title="@(toolCall.ErrorMessage ?? (toolCall.Succeeded == true ? "Succeeded" : toolCall.Succeeded == false ? "Failed" : "Pending"))">
                                    <span class="tool-chip-dot @(toolCall.Succeeded == true ? "succeeded" : toolCall.Succeeded == false ? "failed" : "pending")"></span>
                                    @toolCall.Name
                                </span>
                            }
                        </div>
                    }
                    <div class="bubble-text">@RenderMarkdown(message.Text)</div>
                    @if (!string.IsNullOrEmpty(message.GeneratedImageUrl))
                    {
                        <img class="generated-image" src="@message.GeneratedImageUrl" alt="Generated image" />
                        <div class="bubble-actions">
                            <a class="bubble-action-btn always-visible" href="@message.GeneratedImageUrl" download><Icon Name="download" Size="12" /> Save image</a>
                            <button class="bubble-action-btn always-visible" @onclick="() => CopyImageAsync(message.GeneratedImageUrl!)"><Icon Name="copy" Size="12" /> Copy image</button>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(message.Text))
                    {
                        <div class="bubble-actions copy-actions">
                            <button class="bubble-action-btn" title="Copy message" @onclick="() => CopyTextAsync(message.Text)"><Icon Name="copy" Size="12" /> Copy</button>
                        </div>
                    }
                </div>
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(_pendingAttachedFileName))
        {
            <div class="pending-attachment">
                @if (_pendingAttachedImagePath is not null)
                {
                    <img class="pending-attachment-thumb" src="@ToAttachedImageUrl(_pendingAttachedImagePath)" alt="Attached image preview" />
                }
                else
                {
                    <text>📎</text>
                }
                @_pendingAttachedFileName
                <button class="remove-attachment" title="Remove attachment" @onclick="RemovePendingAttachment"><Icon Name="x" Size="13" /></button>
            </div>
        }
        @if (!string.IsNullOrEmpty(_attachError))
        {
            <div class="attach-error">@_attachError</div>
        }
        @if (AttachedImageVisionWarningText is not null)
        {
            <div class="attach-error">@AttachedImageVisionWarningText</div>
        }

        <div class="input-row">
            <label class="icon-btn attach-btn" title="Attach a file or image"><Icon Name="paperclip" Size="18" /><InputFile OnChange="OnAttachFile" class="attach-input" /></label>
            @if (IsKnowledgeModuleEnabled)
            {
                @* Which knowledge base (if any) this chat uses - down here beside the input like the Avalonia/WPF apps; hidden when the Knowledge Bases module is off. *@
                <select class="kb-select" title="Knowledge base for this chat" @bind="_attachedKnowledgeBaseId" @bind:after="OnKnowledgeBaseChanged">
                    <option value="">(none)</option>
                    @foreach (var kb in _knowledgeBases)
                    {
                        <option value="@kb.Id">@kb.Name</option>
                    }
                </select>
            }
            <textarea @ref="_inputBox" @bind="_inputText" @bind:event="oninput" rows="1"
                      placeholder="Type a message..." disabled="@_isBusy" class="input-box"></textarea>
            @if (_isBusy)
            {
                <button class="stop-button icon-only" title="Stop" aria-label="Stop" @onclick="StopGeneration"><Icon Name="stop" Size="16" /></button>
            }
            else
            {
                <button class="send-button icon-only" @onclick="SendAsync" disabled="@(string.IsNullOrWhiteSpace(_inputText) || _isLoadingModel || AttachedImageVisionWarningText is not null)" title="Send (Enter)" aria-label="Send"><Icon Name="send" Size="18" /></button>
            }
        </div>
    </div>

    <div class="resize-handle" data-var="--rpanel-w" data-side="right" title="Drag to resize - double-click to reset"></div>

    <div class="right-panel">
        <div class="right-panel-tabs">
            <button class="right-panel-tab @(_rightPanelTab == "Stats" ? "active" : "")" @onclick='() => _rightPanelTab = "Stats"'>Stats</button>
            <button class="right-panel-tab @(_rightPanelTab == "Modules" ? "active" : "")" @onclick='() => _rightPanelTab = "Modules"'>Modules</button>
        </div>

        <div class="right-panel-content">
            @if (_rightPanelTab == "Stats")
            {
                <div class="panel-card">
                    <h4>Last reply</h4>
                    <div class="stat-grid">
                        <div class="stat-tile"><span class="stat-number accent">@_lastInputTokens.ToString("N0")</span><span class="stat-caption">Input tokens</span></div>
                        <div class="stat-tile"><span class="stat-number accent">@_lastOutputTokens.ToString("N0")</span><span class="stat-caption">Output tokens</span></div>
                        <div class="stat-tile"><span class="stat-number accent">@_lastTokensPerSecond.ToString("0.0")</span><span class="stat-caption">Tokens / sec</span></div>
                        <div class="stat-tile"><span class="stat-number accent">@_lastTimeToFirstToken.ToString("0.00")s</span><span class="stat-caption">Time to first token</span></div>
                    </div>
                </div>

                <div class="panel-card">
                    <h4>Session</h4>
                    <div class="stat-grid">
                        <div class="stat-tile"><span class="stat-number success">@_sessionTotalInputTokens.ToString("N0")</span><span class="stat-caption">Total input</span></div>
                        <div class="stat-tile"><span class="stat-number success">@_sessionTotalOutputTokens.ToString("N0")</span><span class="stat-caption">Total output</span></div>
                    </div>
                </div>

                <div class="panel-card">
                <h4>Tool calls this turn</h4>
                @if (LastAssistantMessage is { ToolCalls.Count: > 0 } lastMessage)
                {
                    <div class="tool-chips">
                        @foreach (var toolCall in lastMessage.ToolCalls)
                        {
                            <span class="tool-chip" title="@(toolCall.ErrorMessage ?? (toolCall.Succeeded == true ? "Succeeded" : toolCall.Succeeded == false ? "Failed" : "Pending"))">
                                <span class="tool-chip-dot @(toolCall.Succeeded == true ? "succeeded" : toolCall.Succeeded == false ? "failed" : "pending")"></span>
                                @toolCall.Name
                            </span>
                        }
                    </div>
                }
                else
                {
                    <p class="right-panel-empty">No tool calls yet.</p>
                }
                </div>
            }
            else
            {
                @foreach (var module in ModuleRegistry.AllModules)
                {
                    <div class="module-card">
                        <div class="module-card-header">
                            <span class="module-name">@module.Name</span>
                            <span class="module-status-pill @(module.IsEnabled ? "enabled" : "disabled")">@(module.IsEnabled ? "Enabled" : "Disabled")</span>
                        </div>
                        <div class="module-description">@module.Description</div>
                    </div>
                }
            }
        </div>

        <div class="right-panel-actions">
            @if (_rightPanelTab == "Stats")
            {
                <button class="pill-button" @onclick="ShowSystemPrompt"><Icon Name="file-text" Size="14" /> View system prompt</button>
                <button class="pill-button" @onclick="ShowTurnContextAsync"><Icon Name="layers" Size="14" /> View turn context</button>
                <button class="pill-button" @onclick="ShowToolsSent"><Icon Name="wrench" Size="14" /> View tools sent</button>
                <a href="/logs" class="pill-button"><Icon Name="terminal" Size="14" /> View logs</a>
            }
            else
            {
                <a href="/settings" class="pill-button"><Icon Name="settings" Size="14" /> Manage in Settings</a>
            }
        </div>
    </div>
</div>

@if (_isToolsSentOpen)
{
    // "View tools sent", same read-only overlay shape as the
    // System prompt/Model details ones. Reuses
    // BuildRawToolsText - the exact same real wire-format JSON actually
    // sent to the model, not a reconstruction.
    <div class="approval-overlay">
        <div class="approval-dialog">
            <h3>Tools sent</h3>
            <p class="model-details-status">
                Every enabled tool's real name/description/JSON schema, exactly as sent to Lemonade alongside every
                request - this is what the context breakdown's "tools" figure is the token cost of. Reformatted here
                for readability, so pasting THIS text into an external tokenizer will read differently from the
                figure here.
                @if (_toolsSentTokens is int toolsTokens)
                {
                    <text>(~@toolsTokens.ToString("N0") tokens)</text>
                }
            </p>
            <div class="approval-preview system-prompt-text">@BuildPrettyToolsText(ModuleRegistry.GetEnabledTools())</div>
            <div class="approval-buttons">
                <button @onclick="CloseToolsSent">Close</button>
            </div>
        </div>
    </div>
}

@if (_pendingApproval is not null)
{
    // Blazor-native replacement for the desktop apps' modal
    // FileWriteApprovalDialog. See FileWriteApprovalGate's own doc comment
    // for the async "ask and wait" design this overlay resolves.
    <div class="approval-overlay">
        <div class="approval-dialog">
            <h3>The assistant wants to @_pendingApproval.ActionLabel</h3>
            <div class="approval-path">@_pendingApproval.FilePath</div>
            <div class="approval-preview">@_pendingApproval.Preview</div>
            <div class="approval-buttons">
                <button class="approval-deny" @onclick="() => ResolveApproval(ApprovalResult.Deny)">Deny</button>
                <button class="btn-primary" @onclick="() => ResolveApproval(ApprovalResult.AllowOnce)">Allow once</button>
                <button @onclick="() => ResolveApproval(ApprovalResult.AllowForSession)">Allow for this session</button>
            </div>
        </div>
    </div>
}

@if (_pendingImageSize is not null)
{
    // Blazor-native replacement for the desktop apps' modal
    // ImageSizeDialog. Same async "ask and wait" design as the approval
    // overlay above, via ImageSizeGate.
    <div class="approval-overlay">
        <div class="approval-dialog">
            <h3>Generate an image?</h3>
            <div class="approval-preview">@_pendingImageSize.Prompt</div>
            <div class="image-size-fields">
                <label>Width <input type="number" @bind="_imageSizeWidth" /></label>
                <label>Height <input type="number" @bind="_imageSizeHeight" /></label>
            </div>
            <div class="approval-buttons">
                <button class="approval-deny" @onclick="CancelImageGeneration">Cancel</button>
                <button class="btn-primary" @onclick="ConfirmImageGeneration">Generate</button>
            </div>
        </div>
    </div>
}

@if (_isModelDetailsOpen)
{
    // Plain read-only overlay, same visual shape as the
    // approval/image-size ones above but with no "ask and wait" gate behind
    // it (nothing to resolve, just a Close button) - a dialog in spirit, not
    // in the TaskCompletionSource sense.
    <div class="approval-overlay">
        <div class="approval-dialog model-details-dialog">
            <h3>@_selectedModel</h3>
            @if (_modelCatalog.TryGetValue(_selectedModel, out var catalogEntry))
            {
                <dl class="model-details-list">
                    <dt>Capabilities</dt>
                    <dd>@(catalogEntry.Labels.Count > 0 ? string.Join(", ", catalogEntry.Labels) : "(none listed)")</dd>
                    <dt>Max context window</dt>
                    <dd>@catalogEntry.MaxContextWindow.ToString("N0") tokens</dd>
                    <dt>Size on disk</dt>
                    <dd>@catalogEntry.SizeGb.ToString("0.##") GB</dd>
                    <dt>Backend</dt>
                    <dd>@(catalogEntry.Recipe ?? "(unknown)")</dd>
                </dl>
            }
            else
            {
                <p class="model-details-status">No catalog details available for this model.</p>
            }

            @if (_isLoadingModelDetails)
            {
                <p class="model-details-status">Checking whether it's currently loaded...</p>
            }
            else if (_loadedModelDetails is not null)
            {
                <h4>Currently loaded (live)</h4>
                <dl class="model-details-list">
                    <dt>Device</dt>
                    <dd>@(_loadedModelDetails.Device ?? "(unknown)")</dd>
                    @if (_loadedModelDetails.RecipeOptions?.CtxSize is int ctxSize)
                    {
                        <dt>Active context size</dt>
                        <dd>@ctxSize.ToString("N0") tokens</dd>
                    }
                    @if (!string.IsNullOrEmpty(_loadedModelDetails.RecipeOptions?.LlamacppArgs))
                    {
                        <dt>Runtime arguments (llama.cpp)</dt>
                        <dd class="model-details-args">@_loadedModelDetails.RecipeOptions!.LlamacppArgs</dd>
                    }
                </dl>
            }
            else
            {
                <p class="model-details-status">Not currently loaded.</p>
            }

            <div class="approval-buttons">
                <button @onclick="CloseModelDetails">Close</button>
            </div>
        </div>
    </div>
}

@if (_isSystemPromptOpen)
{
    // Plain read-only overlay, same shape as the model-details
    // one above. Shows the REAL, LIVE _history[0] text verbatim (not a
    // reconstruction) - doubles as a direct way to confirm the stable/
    // volatile split (see RefreshStableSystemPrompt's own comment) is
    // actually working: this text should read identically across multiple
    // turns in the same chat unless the compaction summary or pinned facts
    // actually change.
    <div class="approval-overlay">
        <div class="approval-dialog">
            <h3>System prompt (live)</h3>
            <p class="model-details-status">
                Exactly what's currently sitting at the front of the model's context for this chat - the same text
                that gets rebuilt each turn.
                @if (_systemPromptTokens is int systemTokens)
                {
                    <text>(~@systemTokens.ToString("N0") tokens)</text>
                }
            </p>
            <div class="approval-preview system-prompt-text">@(_history.Count > 0 ? _history[0].Text : "(no system message yet)")</div>
            <div class="approval-buttons">
                <button @onclick="CloseSystemPrompt">Close</button>
            </div>
        </div>
    </div>
}

@if (_isTurnContextOpen)
{
    // "View turn context" - what gets silently added to the NEXT message
    // when Send is pressed (time-awareness + relevant memories/knowledge for
    // the text currently in the message box). Same read-only overlay shape
    // as the System prompt one; matches the Avalonia/WPF button of the same
    // name. The header's token-usage click remains the place for the
    // context-usage breakdown.
    <div class="approval-overlay">
        <div class="approval-dialog">
            <h3>Turn context (preview)</h3>
            <p class="model-details-status">
                What gets silently added to your NEXT message when you hit Send - never shown in the chat, never in
                View system prompt. Recomputed fresh every turn, so this is a live preview based on the message
                box's current text, not a historical record.
                @if (_turnContextTokens is int tokenCount)
                {
                    <text>(~@tokenCount.ToString("N0") tokens)</text>
                }
            </p>
            @if (_isTurnContextLoading)
            {
                <p class="model-details-status">Searching memories and knowledge...</p>
            }
            else
            {
                <div class="approval-preview system-prompt-text">@_turnContextText</div>
            }
            <div class="approval-buttons">
                <button @onclick="CloseTurnContext">Close</button>
            </div>
        </div>
    </div>
}

@if (_isContextBreakdownOpen)
{
    // Context-usage breakdown popup. A plain read-only overlay,
    // same shape as the System prompt/Model details ones above - click-
    // triggered rather than Avalonia's own hover-triggered popup, since a
    // Blazor Server hover event would mean a real server round-trip (and a
    // real Lemonade tokenize call) firing on every mouse movement, not a
    // free in-process lookup the way a desktop app's hover is.
    <div class="approval-overlay">
        <div class="approval-dialog">
            <h3>Context usage breakdown</h3>
            @if (_isContextBreakdownLoading)
            {
                <p class="model-details-status">Computing real token counts...</p>
            }
            else if (_contextBreakdownInfo is { } info)
            {
                <p class="context-breakdown-total">
                    <strong>@info.ContextNowTokens.ToString("N0") / @info.ContextMaxTokens.ToString("N0") tokens</strong>
                    (@((int)Math.Round(info.PercentFull))% full)
                    @if (!info.UsedRealTokenizer)
                    {
                        <span class="context-breakdown-approx">- approximate, Lemonade's own tokenizer was unreachable</span>
                    }
                </p>
                <div class="context-breakdown-bar">
                    <div class="context-breakdown-segment system-prompt" style="width: @(info.SystemPromptPercent)%" title="System prompt: @info.SystemPromptTokens.ToString("N0") tokens"></div>
                    <div class="context-breakdown-segment tools" style="width: @(info.ToolsPercent)%" title="Tools: @info.ToolsTokens.ToString("N0") tokens"></div>
                    <div class="context-breakdown-segment history" style="width: @(info.HistoryPercent)%" title="History: @info.HistoryTokens.ToString("N0") tokens"></div>
                    <div class="context-breakdown-marker" style="left: @(info.CompactionThresholdPercent)%" title="Compaction triggers here"></div>
                </div>
                <dl class="model-details-list context-breakdown-legend">
                    <dt><span class="context-breakdown-swatch system-prompt"></span> System prompt</dt>
                    <dd>@info.SystemPromptTokens.ToString("N0") tokens</dd>
                    <dt><span class="context-breakdown-swatch tools"></span> Tools</dt>
                    <dd>@info.ToolsTokens.ToString("N0") tokens</dd>
                    <dt><span class="context-breakdown-swatch history"></span> History (summary + pinned facts + messages)</dt>
                    <dd>@info.HistoryTokens.ToString("N0") tokens</dd>
                    <dt>Free</dt>
                    <dd>@Math.Max(0, info.FreeTokens).ToString("N0") tokens</dd>
                    @if (info.HasCompactions)
                    {
                        <dt>Compacted</dt>
                        <dd>@info.CompactionCount time@(info.CompactionCount == 1 ? "" : "s") this chat</dd>
                    }
                </dl>
                @if (!string.IsNullOrWhiteSpace(_inputText))
                {
                    <p class="context-breakdown-pending@(info.WouldExceedLimit ? " context-breakdown-warning" : "")">
                        If you send now: +@info.PendingTokens.ToString("N0") tokens
                        @if (info.WouldExceedLimit)
                        {
                            <text> - this would exceed the model's context window</text>
                        }
                    </p>
                }
            }
            <div class="approval-buttons">
                <button @onclick="CloseContextBreakdown">Close</button>
            </div>
        </div>
    </div>
}

@code {
