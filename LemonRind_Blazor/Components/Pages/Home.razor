    // authoritative, unchanged list every other method reads/mutates (the same
    // split the desktop editions use); _sidebarGroups is purely a rebuilt-on-
    // demand display projection of it, grouped by FolderId with each
    // group's real FolderSummary (for IsCollapsed) attached. The session
    // list's own SQL query already clusters rows by folder (folders first,
    // "Unfiled" last) so a plain GroupBy preserves that ordering correctly.
    private List<FolderSummary> _folders = [];
    private List<FolderGroup> _sidebarGroups = [];
    private string? _editingFolderSessionId;
    private string _folderSelectValue = "";
    private string _newFolderName = "";
    private string? _editingTagsSessionId;
    private string _newTagText = "";

    // Replaces the four always-visible inline icon buttons
    // (📁🏷⬇×) with a single "⋮" menu, since four plain-text Unicode glyphs
    // sitting in a row "looks messy". No document-wide click-outside-closes
    // detection (would need JS interop this project otherwise avoids for
    // something this small) - the menu closes when an item is picked,
    // another session's own menu is opened, or a chat is switched/started,
    // which covers every normal interaction.
    private string? _openMenuSessionId;
    private void ToggleSessionMenu(string sessionId) => _openMenuSessionId = _openMenuSessionId == sessionId ? null : sessionId;

    private class FolderGroup
    {
        public FolderSummary? Folder { get; set; }
        public List<ChatSessionSummary> Sessions { get; set; } = [];
    }

    private List<string> _availableModels = [];

    // Which capability category each downloaded model belongs to, from
    // Lemonade's own /v1/models "labels" ("chat"/"image"/"embeddings") -
    // drives the grouped dropdown and routes an image-labeled selection
    // straight to image generation instead of a chat request Lemonade would
    // reject with HTTP 400. Same definitions as the Avalonia app.
    private readonly Dictionary<string, string> _modelCategories = new(StringComparer.OrdinalIgnoreCase);
    private const string ModelCategoryChat = "Chat";
    private const string ModelCategoryImage = "Image";
    private const string ModelCategoryEmbedding = "Embedding";
    private const string ModelCategoryOther = "Other";

    private static string DetermineModelCategory(IEnumerable<string> labels)
    {
        var labelSet = new HashSet<string>(labels, StringComparer.OrdinalIgnoreCase);
        if (labelSet.Contains("chat")) return ModelCategoryChat;
        if (labelSet.Contains("image")) return ModelCategoryImage;
        if (labelSet.Contains("embeddings")) return ModelCategoryEmbedding;
        return ModelCategoryOther;
    }

    private static int ModelCategorySortOrder(string category) => category switch
    {
        ModelCategoryChat => 0,
        ModelCategoryImage => 1,
        ModelCategoryEmbedding => 2,
        _ => 3,
    };

    private static string ModelCategoryHeaderText(string category) => category switch
    {
        ModelCategoryChat => "Chat models",
        ModelCategoryImage => "Image models",
        ModelCategoryEmbedding => "Embedding models",
        _ => "Other models",
    };

    /// <summary>One group per category actually present (never an empty "Embedding models" header), in Chat/Image/Embedding/Other order.</summary>
    private IEnumerable<(string Header, List<string> Models)> GroupedModels =>
        _availableModels
            .GroupBy(m => _modelCategories.GetValueOrDefault(m, ModelCategoryOther))
            .OrderBy(g => ModelCategorySortOrder(g.Key))
            .Select(g => (ModelCategoryHeaderText(g.Key), g.ToList()));

    private string? _modelLoadError;
    private int _modelLoadSeconds;

    // Session rename (sidebar menu -> inline title edit). Enter or losing
    // focus commits, Escape cancels.
    private string? _renamingSessionId;
    private string _renameText = "";
    private ElementReference _renameInput;
    private bool _focusRenameInput;

    private ElementReference _inputBox;
    private DotNetObjectReference<Home>? _selfReference;

    private readonly Dictionary<string, int> _modelContextWindows = new(StringComparer.OrdinalIgnoreCase);
    private string _selectedModel = "";
    private string _currentSessionId = "";
    private string _inputText = "";
    private string _searchText = "";
    private bool _isBusy;
    private bool _isHealthy;
    private bool _isLoadingModel;
    private CancellationTokenSource? _searchDebounceCts;

    // Lemonade reconnect. null while healthy - the detailed
    // connection-failure message lives here (shown via the health button's
    // own title tooltip) rather than crowding the header with a long
    // connection-refused message that would push everything else out.
    private string? _lastHealthCheckError;
    private Timer? _connectionRetryTimer;

    // A real Stop button, threaded through GetStreamingResponseAsync's
    // own CancellationToken, so a runaway/stuck generation (e.g. Lemonade
    // looping past 80,000+ output tokens) can always be cancelled.
    private CancellationTokenSource? _sendCts;

    // Short-term memory / compaction. Deliberately in-memory only,
    // not persisted (unlike MemoryService's own durable facts) - a fresh
    // reload of a session doesn't need its compaction summary restored,
    // just the real transcript.
    private string _conversationSummaryText = "";
    private const int MessagesToKeepAfterCompaction = 6;

    // null (not 0) means "no real turn has happened in this
    // chat yet", distinct from a genuine 0-token reading. Otherwise a
    // brand-new empty chat would show a misleading "0 / 262,144 tokens (0%)"
    // the instant _contextUsageMax got populated (at init or a reconnect
    // retry), regardless of whether this specific chat had ever sent
    // anything (there would be no third "not started" state, just
    // "blank" or "a real number"). _contextUsageMax itself still always
    // reflects the selected model's real ceiling, independent of any one
    // chat's state.
    private int? _contextUsageCurrent;
    private int _contextUsageMax;

    // Right-hand Stats/Modules panel, matching the pane both
    // WPF and Avalonia already have. "Last reply" fields come straight off
    // Lemonade's own /v1/stats response (replacing the old inline header
    // _statsText line, now redundant); "Session" totals are this app's own
    // running accumulation, in-memory only (never persisted), reset
    // alongside everything else in NewChat/LoadSession.
    private string _rightPanelTab = "Stats";
    private int _lastInputTokens;
    private int _lastOutputTokens;
    private double _lastTokensPerSecond;
    private double _lastTimeToFirstToken;
    private int _sessionTotalInputTokens;
    private int _sessionTotalOutputTokens;
    private bool _isToolsSentOpen;

    /// <summary>The Stats tab's "Tool calls this turn" doesn't duplicate state - it's just whichever assistant bubble is currently last, same non-duplicating approach Avalonia's own RightPanelToolCalls uses.</summary>
    private DisplayMessage? LastAssistantMessage => _messages.LastOrDefault(m => !m.IsUser);

    private int? _toolsSentTokens;

    private async Task ShowToolsSent()
    {
        _toolsSentTokens = null;
        _isToolsSentOpen = true;
        StateHasChanged();

        // The same figure the context breakdown shows for "tools" - counted
        // from the compact wire-format JSON, not the reformatted display text.
        _toolsSentTokens = await TryTokenizeAsync(BuildRawToolsText(ModuleRegistry.GetEnabledTools()));
    }

    /// <summary>
    /// Real count via Lemonade's own tokenizer, falling back to a rough
    /// ~4-characters-per-token guess if it can't be reached (or the
    /// endpoint is missing) - shared by every "view X (~N tokens)" overlay
    /// so each one always shows a number, same as the WPF/Avalonia apps.
    /// </summary>
    private async Task<int> TryTokenizeAsync(string text)
    {
        try { return await ManagementClient.TokenizeAsync(text, CancellationToken.None); }
        catch { return string.IsNullOrEmpty(text) ? 0 : Math.Max(1, text.Length / 4); }
    }

    /// <summary>
    /// Every enabled tool laid out readably - "### name", description,
    /// indented schema JSON, "---" separators (as the WPF app shows it) -
    /// instead of one unbroken line of compact JSON.
    /// </summary>
    private static string BuildPrettyToolsText(IEnumerable<AITool> tools)
    {
        var indented = new System.Text.Json.JsonSerializerOptions { WriteIndented = true };
        var sections = tools.Select(t =>
        {
            var schemaText = t is AIFunction function ? System.Text.Json.JsonSerializer.Serialize(function.JsonSchema, indented) : "(no schema)";
            return $"### {t.Name}\n{t.Description}\n\n{schemaText}";
        }).ToList();
        return sections.Count == 0 ? "(no modules with tools are currently enabled)" : string.Join("\n\n---\n\n", sections);
    }
    private void CloseToolsSent() => _isToolsSentOpen = false;

    // Real tool-call success/failure tracking, replacing Stage
    // 4's plain tool-name strings. Succeeded is a nullable bool, starting
    // null ("call made, no result yet") - never defaulted to true, since
    // that would be misleading before a real result exists.
    private class ToolCallResult
    {
        public required string Name { get; init; }
        public required string CallId { get; init; }
        public bool? Succeeded { get; set; }
        public string? ErrorMessage { get; set; }

        // "name:1" (success) / "name:0" (failure) / "name:?" (still
        // pending, shouldn't normally persist in this state but handled for
        // symmetry) in the Messages.ToolCalls column. ParseFromStorage also
        // accepts a bare name with no colon at all - the original
        // pre-tracking format, parsed as Succeeded = null (backward
        // compatibility with rows saved before success tracking).
        public string SerializeForStorage() => Succeeded switch
        {
            true => $"{Name}:1",
            false => $"{Name}:0",
            null => $"{Name}:?",
        };

        public static ToolCallResult ParseFromStorage(string stored)
        {
            var colonIndex = stored.LastIndexOf(':');
            if (colonIndex < 0) return new ToolCallResult { Name = stored, CallId = "" };

            var name = stored[..colonIndex];
            bool? succeeded = stored[(colonIndex + 1)..] switch { "1" => true, "0" => false, _ => null };
            return new ToolCallResult { Name = name, CallId = "", Succeeded = succeeded };
        }
    }

    private class DisplayMessage
    {
        public required bool IsUser { get; init; }
        public string Text { get; set; } = "";
        public string ReasoningText { get; set; } = "";

        // A call is added once (on its FunctionCallContent), then the
        // matching FunctionResultContent (correlated by CallId) resolves
        // its own Succeeded/ErrorMessage in place - no separate dedup set
        // needed now, a CallId already in the list just gets looked up.
        public List<ToolCallResult> ToolCalls { get; } = [];

        // Set only on a user bubble that had a one-off file
        // attached that turn; shown as a small filename chip rather than
        // dumping the full extracted text into the visible transcript (that
        // goes to the model only, via SendAsync's own textForModel).
        public string? AttachedFileName { get; set; }

        // Set on a USER bubble that attached an image for vision
        // input (never both this and AttachedFileName at once - one
        // attachment slot, routed to either path by file extension). Already
        // the small downscaled copy ImageAttachmentService saved, served
        // over /attached-images the same way GeneratedImageUrl is.
        public string? AttachedImageUrl { get; set; }

        // Set when this reply's text contains generate_image's own
        // ready-made Markdown image link (![alt](file:///...)) - extracted via
        // regex rather than a full Markdown renderer.
        // Holds the already-converted web-relative URL (/generated-images/...),
        // not the raw file:// URI, since that's what the <img> tag needs.
        public string? GeneratedImageUrl { get; set; }

        // Date dividers + hover timestamps. CreatedAt is set once
        // at construction (DateTime.Now for a live message, the real
        // persisted StoredChatMessage.CreatedAt for a reloaded one).
        // DateDividerText is only ever non-null on whichever message starts
        // a new calendar day - set by SetDateDividerIfNeeded, called right
        // after every _messages.Add(...) call site.
        public DateTime CreatedAt { get; init; } = DateTime.Now;
        public string? DateDividerText { get; set; }

        // Prompt-processing progress indicator. Only ever
        // meaningful before any real answer/reasoning text has arrived (see
        // SendAsync's own streaming-loop comment) - cleared the instant
        // either one starts, plus a final safety-net clear after the
        // streaming try/catch so a stuck percentage can never linger on a
        // cancelled or errored reply.
        public string? PromptProgressText { get; set; }

        // Compaction visibility. A second, visually-distinct chip
        // collection alongside ToolCalls (amber, no status dot, since these
        // aren't something the model did) that makes compaction visible.
        public List<string> SystemNotes { get; } = [];
    }

    // RAG (Knowledge Bases) + one-off file analysis.
    private List<KnowledgeBaseSummary> _knowledgeBases = [];
    private string _attachedKnowledgeBaseId = "";
    private string? _pendingAttachedFileText;
    private string? _pendingAttachedFileName;
    private string? _attachError;

    // Knowledge Bases as a toggleable module. KnowledgeModule
    // itself gates this feature: the KB dropdown shows and SendAsync
    // fetches knowledge-base text only when its IsEnabled flag is set. This
    // property is that check, read fresh on every render (never cached) so a live
    // Settings toggle takes effect immediately, same as every other module.
    private bool IsKnowledgeModuleEnabled => ModuleRegistry.IsModuleEnabled("Knowledge");

    // Image attachment (vision input). _pendingAttachedImagePath
    // is the already-downscaled local copy's path, mutually exclusive with
    // _pendingAttachedFileText (one attachment slot, routed by extension).
    // _modelVisionSupport mirrors _modelContextWindows's own shape/lifetime -
    // populated once alongside it from /v1/models' real "labels" field.
    private string? _pendingAttachedImagePath;
    private readonly Dictionary<string, bool> _modelVisionSupport = new(StringComparer.OrdinalIgnoreCase);

    // Model details overlay. _modelCatalog is a third parallel
    // per-model lookup (same shape/lifetime as _modelContextWindows/
    // _modelVisionSupport, populated alongside them) holding the full
    // /v1/models catalog entry, not just the one field each of those already
    // extracted. Whether a model is actually loaded RIGHT NOW is queried
    // fresh from /v1/health on each open rather than cached - a low-
    // frequency user action doesn't need that complexity, and a model can
    // load/unload between clicks.
    private readonly Dictionary<string, LemonadeModelInfo> _modelCatalog = new(StringComparer.OrdinalIgnoreCase);
    private bool _isModelDetailsOpen;
    private bool _isLoadingModelDetails;
    private LemonadeLoadedModelInfo? _loadedModelDetails;

    private async Task ShowModelDetailsAsync()
    {
        _isModelDetailsOpen = true;
        _isLoadingModelDetails = true;
        _loadedModelDetails = null;
        StateHasChanged();

        try
        {
            var health = await ManagementClient.GetHealthAsync(CancellationToken.None);
            _loadedModelDetails = health?.AllModelsLoaded.FirstOrDefault(m => string.Equals(m.ModelName, _selectedModel, StringComparison.OrdinalIgnoreCase));
        }
        catch
        {
            // Best-effort - the catalog section above still shows whatever's cached, even if this live check fails.
        }
        finally
        {
            _isLoadingModelDetails = false;
            StateHasChanged();
        }
    }

    private void CloseModelDetails() => _isModelDetailsOpen = false;

    // "View system prompt". No "ask and wait" gate behind it
    // (same as the model-details overlay above) - just shows _history[0]
    // live, nothing to resolve.
    private bool _isSystemPromptOpen;
    private int? _systemPromptTokens;

    private async Task ShowSystemPrompt()
    {
        _systemPromptTokens = null;
        _isSystemPromptOpen = true;
        StateHasChanged();
        _systemPromptTokens = await TryTokenizeAsync(_history.Count > 0 ? _history[0].Text ?? "" : "");
    }
    private void CloseSystemPrompt() => _isSystemPromptOpen = false;

    // Context-usage breakdown popup. A plain POCO snapshot (not
    // an observable ViewModel - Blazor's own render model doesn't need one),
    // computed fresh every time the popup opens via real Lemonade
    // /v1/tokenize calls (an exact count, not the rough ~4-chars-per-token
    // guess used elsewhere for a cheap "did compaction help" comparison) -
    // falls back to that same chars/4 estimate only if the real tokenizer
    // call fails (Lemonade unreachable), UsedRealTokenizer records which
    // happened so the UI can say so honestly rather than presenting an
    // estimate as exact. Segment widths are sized against the real max
    // context window, never rescaled to force-sum to 100% - a small honest
    // gap versus chat-template rendering overhead the real tokenizer calls
    // don't capture (message wrapper tokens, role markers, etc.) shows up
    // as visible free space rather than being papered over.
    private class ContextBreakdown
    {
        public int ContextNowTokens { get; set; }
        public int ContextMaxTokens { get; set; }
        public double PercentFull { get; set; }
        public bool UsedRealTokenizer { get; set; }
        public int SystemPromptTokens { get; set; }
        public int ToolsTokens { get; set; }
        public int HistoryTokens { get; set; }
        public int FreeTokens { get; set; }
        public int CompactionThresholdTokens { get; set; }
        public int CompactionCount { get; set; }
        public bool HasCompactions => CompactionCount > 0;
        public int PendingTokens { get; set; }
        public bool WouldExceedLimit { get; set; }

        private double Pct(int tokens) => ContextMaxTokens > 0 ? Math.Clamp(100.0 * tokens / ContextMaxTokens, 0, 100) : 0;
        public double SystemPromptPercent => Pct(SystemPromptTokens);
        public double ToolsPercent => Pct(ToolsTokens);
        public double HistoryPercent => Pct(HistoryTokens);
        public double CompactionThresholdPercent => Pct(CompactionThresholdTokens);
    }

    private bool _isContextBreakdownOpen;
    private bool _isContextBreakdownLoading;
    private ContextBreakdown? _contextBreakdownInfo;

    // Incremented in CompactHistoryIfNeededAsync's own success path, reset
    // alongside _conversationSummaryText in both NewChat/LoadSession -
    // in-memory only, same scope as every other short-term-memory field.
    private int _compactionCount;

    private async Task ShowContextBreakdownAsync()
    {
        _isContextBreakdownOpen = true;
        _isContextBreakdownLoading = true;
        _contextBreakdownInfo = null;
        StateHasChanged();

        try
        {
            var systemPromptText = _history.Count > 0 ? (_history[0].Text ?? "") : "";
            var toolsText = BuildRawToolsText(ModuleRegistry.GetEnabledTools());
            var historyText = string.Join(" ", _history.Skip(1).Select(ExtractMessageText));

            var systemPromptTokens = await ManagementClient.TokenizeAsync(systemPromptText, CancellationToken.None);
            var toolsTokens = await ManagementClient.TokenizeAsync(toolsText, CancellationToken.None);
            var historyTokens = await ManagementClient.TokenizeAsync(historyText, CancellationToken.None);

            var contextMax = _contextUsageMax;
            var contextNow = _contextUsageCurrent ?? (systemPromptTokens + toolsTokens + historyTokens);
            var compactionThreshold = (int)Math.Round(contextMax * Settings.Memory.CompactionTriggerPercent / 100.0);

            var pendingTokens = 0;
            if (!string.IsNullOrWhiteSpace(_inputText))
            {
                // The same "what would actually be sent" preview SendAsync's
                // own AppendVolatileContext builds for a real turn - time-
                // awareness + memory/knowledge search against whatever's
                // currently typed, not yet committed to _history.
                var volatileText = await BuildLiveTurnContextTextAsync(_inputText) + "\n\n" + _inputText;
                pendingTokens = await ManagementClient.TokenizeAsync(volatileText, CancellationToken.None);
            }

            _contextBreakdownInfo = new ContextBreakdown
            {
                ContextNowTokens = contextNow,
                ContextMaxTokens = contextMax,
                PercentFull = contextMax > 0 ? 100.0 * contextNow / contextMax : 0,
                UsedRealTokenizer = true,
                SystemPromptTokens = systemPromptTokens,
                ToolsTokens = toolsTokens,
                HistoryTokens = historyTokens,
                FreeTokens = contextMax - systemPromptTokens - toolsTokens - historyTokens,
                CompactionThresholdTokens = compactionThreshold,
                CompactionCount = _compactionCount,
                PendingTokens = pendingTokens,
                WouldExceedLimit = contextNow + pendingTokens >= contextMax,
            };
        }
        catch
        {
            // Best-effort - Lemonade's own tokenizer endpoint might be
            // unreachable (reconnect in progress, etc.); fall back to the
            // same rough ~4-chars-per-token estimate
            // CompactHistoryIfNeededAsync already uses elsewhere rather than
            // showing nothing at all.
            var estimatedChars = _history.Sum(m => (m.Text ?? "").Length);
            var estimatedTokens = Math.Max(1, estimatedChars / 4);
            _contextBreakdownInfo = new ContextBreakdown
            {
                ContextNowTokens = _contextUsageCurrent ?? estimatedTokens,
                ContextMaxTokens = _contextUsageMax,
                PercentFull = _contextUsageMax > 0 ? 100.0 * (_contextUsageCurrent ?? estimatedTokens) / _contextUsageMax : 0,
                UsedRealTokenizer = false,
                HistoryTokens = estimatedTokens,
                FreeTokens = _contextUsageMax - estimatedTokens,
                CompactionCount = _compactionCount,
            };
        }
        finally
        {
            _isContextBreakdownLoading = false;
            StateHasChanged();
        }
    }

    private void CloseContextBreakdown() => _isContextBreakdownOpen = false;

    /// <summary>
    /// The genuine volatile per-turn content (time-awareness + whatever
    /// memory/knowledge search surfaces) for the given draft text - shared by
    /// SendAsync, the "View turn context" preview and the context breakdown's
    /// pending-token estimate so the real search is only written once. Memory
    /// and knowledge both need real text to search against, so a blank draft
    /// yields just the time line.
    /// </summary>
    private async Task<string> BuildLiveTurnContextTextAsync(string draftText)
    {
        var sections = new List<string> { TimeAwareness.BuildTimeAwarenessText() };

        if (!string.IsNullOrWhiteSpace(draftText))
        {
            var relevantMemoriesText = await MemoryService.GetRelevantMemoriesTextAsync(draftText, CancellationToken.None);
            if (!string.IsNullOrEmpty(relevantMemoriesText)) sections.Add(relevantMemoriesText);

            // Fetched unconditionally when the module is on (not gated on a KB
            // being attached) - the "no knowledge base is attached" text
            // matters as much as real chunks; see SendAsync.
            if (IsKnowledgeModuleEnabled)
            {
                var knowledgeText = await KnowledgeService.GetRelevantChunksTextAsync(string.IsNullOrEmpty(_attachedKnowledgeBaseId) ? null : _attachedKnowledgeBaseId, draftText, CancellationToken.None);
                if (!string.IsNullOrEmpty(knowledgeText)) sections.Add(knowledgeText);
            }
        }

        return string.Join("\n\n", sections);
    }

    private bool _isTurnContextOpen;
    private bool _isTurnContextLoading;
    private string _turnContextText = "";
    private int? _turnContextTokens;

    private async Task ShowTurnContextAsync()
    {
        _isTurnContextOpen = true;
        _isTurnContextLoading = true;
        _turnContextTokens = null;
        StateHasChanged();

        try
        {
            var text = await BuildLiveTurnContextTextAsync(_inputText);
            _turnContextTokens = await TryTokenizeAsync(text);

            _turnContextText = string.IsNullOrWhiteSpace(_inputText)
                ? text + "\n\n(Type something in the message box first to preview what relevant memories/knowledge would be included for it - both need real text to search against.)"
                : text;
        }
        catch (Exception ex)
        {
            _turnContextText = $"Couldn't build the turn context: {ex.Message}";
        }
        finally
        {
            _isTurnContextLoading = false;
            StateHasChanged();
        }
    }

    private void CloseTurnContext() => _isTurnContextOpen = false;

    /// <summary>
    /// The real OpenAI wire-format tools array (type/function/name/
    /// description/parameters), not a bare schema dump - the wrapper syntax
    /// itself costs real tokens a plain concatenation of descriptions would
    /// miss entirely.
    /// </summary>
    private static string BuildRawToolsText(IEnumerable<AITool> tools)
    {
        var toolsArray = tools.OfType<AIFunction>().Select(f => new
        {
            type = "function",
            function = new { name = f.Name, description = f.Description, parameters = f.JsonSchema },
        });
        return System.Text.Json.JsonSerializer.Serialize(toolsArray);
    }

    /// <summary>
    /// Walks a ChatMessage's Contents directly rather than its .Text-only
    /// shortcut, since a tool call's arguments/a tool result's own output
    /// contribute real tokens .Text alone never sees.
    /// </summary>
    private static string ExtractMessageText(ChatMessage message)
    {
        var parts = new List<string>();
        foreach (var content in message.Contents)
        {
            if (content is TextContent text) parts.Add(text.Text);
            else if (content is TextReasoningContent reasoning) parts.Add(reasoning.Text);
            else if (content is FunctionCallContent call) parts.Add($"{call.Name}({System.Text.Json.JsonSerializer.Serialize(call.Arguments)})");
            else if (content is FunctionResultContent result) parts.Add(result.Result?.ToString() ?? "");
        }
        return string.Join(" ", parts);
    }

    // Date dividers + hover timestamps, as in the desktop editions'
    // ComputeDateDividerText/SetDateDividerIfNeeded.
    private static string? ComputeDateDividerText(DateTime? previousDate, DateTime currentCreatedAt)
    {
        var currentDate = currentCreatedAt.Date;
        if (previousDate.HasValue && previousDate.Value == currentDate) return null;

        if (currentDate == DateTime.Today) return "Today";
        if (currentDate == DateTime.Today.AddDays(-1)) return "Yesterday";
        return currentCreatedAt.ToString("dddd, d MMMM yyyy");
    }

    /// <summary>Call right after _messages.Add(message) - compares against whatever is now the second-to-last entry.</summary>
    private void SetDateDividerIfNeeded(DisplayMessage message)
    {
        DateTime? previousDate = _messages.Count > 1 ? _messages[^2].CreatedAt.Date : null;
        message.DateDividerText = ComputeDateDividerText(previousDate, message.CreatedAt);
    }

    // Blazor-native file-write approval overlay. Subscribed once
    // at init, unsubscribed on Dispose - see FileWriteApprovalGate's own
    // doc comment for the full design.
    private FileWriteApprovalRequest? _pendingApproval;

    private void OnPendingApprovalChanged(FileWriteApprovalRequest? request)
