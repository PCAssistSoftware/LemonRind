    // Scheduler. Raised from ScheduledJobRunner running on the poll
    // Timer's own thread pool thread, never this circuit's own synchronization
    // context - InvokeAsync marshals both the sidebar refresh and (if it's the
    // session currently open) the visible transcript reload onto the circuit,
    // the same reason the Avalonia app's own Dispatcher.UIThread.Post was
    // needed there. Fires more than once per job - when the prompt is first
    // saved, when the "running in background" note is saved, and when the
    // final reply/error lands.
    private void OnSchedulerSessionUpdated(object? sender, string sessionId)
    {
        InvokeAsync(() =>
        {
            RefreshSessions();
            if (sessionId == _currentSessionId) LoadSession(sessionId, forceReload: true);
            StateHasChanged();
        });
    }

    private void ResolveApproval(ApprovalResult result)
    {
        _pendingApproval?.Completion.TrySetResult(result);
    }

    protected override async Task OnInitializedAsync()
    {
        ApprovalGate.OnPendingRequestChanged += OnPendingApprovalChanged;
        SchedulerNotifier.SessionUpdated += OnSchedulerSessionUpdated;
        ImageSizeGate.OnPendingRequestChanged += OnPendingImageSizeChanged;

        _knowledgeBases = KnowledgeRepository.ListKnowledgeBases();

        var health = await RefreshAvailableModelsAsync(CancellationToken.None);

        // One-time initial-selection logic - RefreshAvailableModelsAsync
        // itself just refreshes the catalog/health and preserves whatever
        // was already selected; only this first call (with _selectedModel
        // still empty) needs to actually pick one.
        //
        // A background embedding call (memory retrieval, KB
        // ingestion/retrieval) can legitimately be the last thing to
        // touch Lemonade's single model slot before this page loads -
        // /v1/health's own ModelLoaded then faithfully (but unhelpfully)
        // reports the embedding model, not the real chat model. So this
        // checks the loaded model's category too, not just the configured
        // embedding model.
        var isRealChatModel = !string.IsNullOrEmpty(health?.ModelLoaded)
            && _availableModels.Contains(health.ModelLoaded)
            && _modelCategories.GetValueOrDefault(health.ModelLoaded) == ModelCategoryChat
            && !string.Equals(health.ModelLoaded, Settings.Lemonade.EmbeddingModel, StringComparison.OrdinalIgnoreCase);

        if (isRealChatModel)
        {
            _selectedModel = health!.ModelLoaded!;
        }
        else if (_availableModels.Contains(Settings.Lemonade.ChatModel))
        {
            _selectedModel = Settings.Lemonade.ChatModel;
        }
        else if (_availableModels.Count > 0)
        {
            _selectedModel = _availableModels.FirstOrDefault(m => _modelCategories.GetValueOrDefault(m) == ModelCategoryChat
                    && !string.Equals(m, Settings.Lemonade.EmbeddingModel, StringComparison.OrdinalIgnoreCase))
                ?? _availableModels[0];
        }
        _contextUsageMax = _modelContextWindows.GetValueOrDefault(_selectedModel, 0);

        RefreshFolders();
        RefreshSessions();

        // Resume the most recently used chat rather than always starting a
        // brand new one - this avoids the
        // "new empty chat piles up on every launch" problem.
        if (_sessions.Count > 0)
        {
            LoadSession(_sessions[0].Id);
        }
        else
        {
            NewChat();
        }

        // Lemonade reconnect. Keeps retrying in the background
        // while unreachable, so coming back online doesn't require a manual
        // retry click. A no-op tick while already healthy costs nothing
        // worth guarding against, so this just runs for the circuit's whole
        // lifetime rather than being started/stopped around IsHealthy
        // transitions.
        _connectionRetryTimer = new Timer(OnConnectionRetryTimerTick, null, TimeSpan.FromSeconds(15), TimeSpan.FromSeconds(15));
    }

    /// <summary>
    /// Refreshes health + the full model catalog (availability, context
    /// windows, vision support, full details) in one pass - called once at
    /// startup, then again by the background retry timer (only while
    /// unhealthy) and by a manual retry click. Preserves whatever model is
    /// currently selected rather than resetting it - nothing about the
    /// loaded model itself changed just because the connection dropped and
    /// came back; only _contextUsageMax gets re-read for it. Returns the
    /// fetched health info so the one-time startup selection logic can
    /// reuse it without a second round-trip.
    /// </summary>
    private async Task<LemonadeHealthInfo?> RefreshAvailableModelsAsync(CancellationToken cancellationToken)
    {
        LemonadeHealthInfo? health = null;
        try
        {
            health = await ManagementClient.GetHealthAsync(cancellationToken);
            _isHealthy = string.Equals(health?.Status, "ok", StringComparison.OrdinalIgnoreCase) || health is not null;
            _lastHealthCheckError = null;

            var models = await ManagementClient.ListDownloadedModelsAsync(cancellationToken);
            // Chat models first, then Image, Embedding, other - not just
            // alphabetical, so a real chat model is the first thing shown.
            _modelCategories.Clear();
            foreach (var model in models) _modelCategories[model.Id] = DetermineModelCategory(model.Labels);
            _availableModels = models.OrderBy(m => ModelCategorySortOrder(_modelCategories[m.Id])).Select(m => m.Id).ToList();
            foreach (var model in models)
            {
                _modelContextWindows[model.Id] = model.MaxContextWindow;
                _modelVisionSupport[model.Id] = model.Labels.Any(label => string.Equals(label, "vision", StringComparison.OrdinalIgnoreCase));
                _modelCatalog[model.Id] = model;
            }

            if (!string.IsNullOrEmpty(_selectedModel))
            {
                _contextUsageMax = _modelContextWindows.GetValueOrDefault(_selectedModel, 0);
            }
        }
        catch (Exception ex)
        {
            _isHealthy = false;
            _lastHealthCheckError = ex.Message;
        }
        return health;
    }

    private async void OnConnectionRetryTimerTick(object? state)
    {
        if (!_isHealthy)
        {
            await RefreshAvailableModelsAsync(CancellationToken.None);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RetryConnectionAsync() => await RefreshAvailableModelsAsync(CancellationToken.None);

    private async Task RefreshHealthAsync()
    {
        try
        {
            var health = await ManagementClient.GetHealthAsync(CancellationToken.None);
            _isHealthy = string.Equals(health?.Status, "ok", StringComparison.OrdinalIgnoreCase) || health is not null;
            _lastHealthCheckError = null;
        }
        catch (Exception ex)
        {
            _isHealthy = false;
            _lastHealthCheckError = ex.Message;
        }
    }

