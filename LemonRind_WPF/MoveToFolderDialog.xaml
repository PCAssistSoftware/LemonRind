<Window x:Class="MoveToFolderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Move to folder" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        Icon="Assets/AppIcon.ico"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/DialogButtonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Folder" FontWeight="Bold" Margin="0,0,0,4" />
        <ComboBox x:Name="FolderComboBox" Grid.Row="1" Padding="6" DisplayMemberPath="Name" />

        <TextBlock Grid.Row="2" Text="Or create a new folder" FontWeight="Bold" Margin="0,16,0,4" />
        <TextBox x:Name="NewFolderNameBox" Grid.Row="3" Padding="6" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="CancelButtonElement" Content="Cancel" Padding="14,7" Margin="0,0,8,0"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    Click="OnCancelClick" IsCancel="True" />
            <Button x:Name="MoveButtonElement" Content="Move" Padding="14,7"
                    Style="{StaticResource DialogPrimaryButtonStyle}"
                    Click="OnMoveClick" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
