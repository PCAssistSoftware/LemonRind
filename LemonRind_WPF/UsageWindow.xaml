<Window x:Class="UsageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LemonRind.Controls"
        Title="Usage" Width="980" Height="820" MinWidth="640" MinHeight="400"
        Icon="Assets/AppIcon.ico"
        WindowStartupLocation="CenterOwner">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Usage" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Tokens and speed from the replies this app has saved (chats and scheduled jobs)."
                       Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0" />

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <ComboBox x:Name="PeriodBox" MinWidth="130" SelectionChanged="OnFilterChanged" />
                <ComboBox x:Name="ModelBox" MinWidth="280" Margin="12,0,0,0" SelectionChanged="OnFilterChanged" />
                <CheckBox x:Name="ScheduledBox" Content="Include scheduled jobs" IsChecked="True" Margin="12,0,0,0"
                          VerticalAlignment="Center" Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
            </StackPanel>

            <TextBlock x:Name="EmptyText" Text="No replies with numbers in this period." Visibility="Collapsed"
                       Foreground="Gray" Margin="0,16" />

            <StackPanel x:Name="ReportPanel">
                <WrapPanel x:Name="TilesPanel" Margin="0,14,0,0" />

                <TextBlock x:Name="TokensTitle" FontWeight="SemiBold" Margin="0,12,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Border Width="12" Height="12" CornerRadius="2" Background="#1976D2" VerticalAlignment="Center" />
                    <TextBlock Text="Tokens in" FontSize="12" Foreground="Gray" Margin="6,0,0,0" />
                    <Border Width="12" Height="12" CornerRadius="2" Background="#26A69A" Margin="16,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="Tokens out" FontSize="12" Foreground="Gray" Margin="6,0,0,0" />
                </StackPanel>
                <Border BorderBrush="#E2E5EA" BorderThickness="1" CornerRadius="8" Background="White">
                    <controls:UsageChart x:Name="TokenChart" Height="220" />
                </Border>

                <TextBlock Text="Speed (tokens per second)" FontWeight="SemiBold" Margin="0,16,0,4" />
                <Border BorderBrush="#E2E5EA" BorderThickness="1" CornerRadius="8" Background="White">
                    <controls:UsageChart x:Name="SpeedChart" ShowSpeed="True" Height="170" />
                </Border>

                <TextBlock Text="By model" FontWeight="SemiBold" Margin="0,16,0,4" />
                <StackPanel x:Name="ModelsHost" />

                <TextBlock Text="Tools" FontWeight="SemiBold" Margin="0,16,0,4" />
                <StackPanel x:Name="ToolsHost" />

                <TextBlock x:Name="ChatsTitle" Text="Busiest chats" FontWeight="SemiBold" Margin="0,16,0,4" />
                <StackPanel x:Name="ChatsHost" />

                <StackPanel x:Name="NotesHost" Margin="0,16,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
