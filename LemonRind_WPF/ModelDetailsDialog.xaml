<Window x:Class="ModelDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Model details" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        Icon="Assets/AppIcon.ico"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/DialogButtonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="DetailLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="Gray" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,10,0,0" />
            </Style>
            <Style x:Key="DetailValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="ModelIdText" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" />

            <TextBlock Text="Capabilities" Style="{StaticResource DetailLabelStyle}" />
            <TextBlock x:Name="LabelsText" Style="{StaticResource DetailValueStyle}" />

            <TextBlock Text="Context window" Style="{StaticResource DetailLabelStyle}" />
            <TextBlock x:Name="ContextWindowText" Style="{StaticResource DetailValueStyle}" />

            <TextBlock Text="Size on disk" Style="{StaticResource DetailLabelStyle}" />
            <TextBlock x:Name="SizeText" Style="{StaticResource DetailValueStyle}" />

            <TextBlock Text="Backend" Style="{StaticResource DetailLabelStyle}" />
            <TextBlock x:Name="BackendText" Style="{StaticResource DetailValueStyle}" />

            <!-- Only present once this model is actually loaded - see
                 ModelDetailsDialog.xaml.vb's comment on why the richer
                 runtime detail (llamacpp_args in particular) only exists
                 for a running model, not the static catalog entry. -->
            <TextBlock x:Name="NotLoadedNoteText" Style="{StaticResource DetailValueStyle}"
                       Foreground="#B8860B" Margin="0,14,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

            <StackPanel x:Name="RuntimeDetailPanel" Visibility="Collapsed">
                <TextBlock Text="Device" Style="{StaticResource DetailLabelStyle}" />
                <TextBlock x:Name="DeviceText" Style="{StaticResource DetailValueStyle}" />

                <TextBlock Text="Runtime arguments (llama.cpp)" Style="{StaticResource DetailLabelStyle}" />
                <!-- A real, selectable TextBox (not a TextBlock) - same
                     "reply text should be selectable" reasoning as the chat
                     bubbles themselves, since this is exactly the kind of
                     string a user would want to copy out. -->
                <TextBox x:Name="LlamacppArgsText" IsReadOnly="True" TextWrapping="Wrap"
                         FontFamily="Consolas" FontSize="12" Background="#F5F5F5" BorderThickness="0"
                         Padding="8" Margin="0,4,0,0" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="CloseButtonElement" Padding="14,7"
                    Style="{StaticResource DialogPrimaryButtonStyle}"
                    Click="OnCloseClick" IsDefault="True" IsCancel="True" Content="Close" />
        </StackPanel>
    </Grid>
</Window>
